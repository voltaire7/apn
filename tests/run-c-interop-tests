#!/bin/sh
set -eu
DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
BUILD="$(mktemp -d "${TMPDIR:-/tmp}/apn-ffi-test.XXXXXX")"
trap 'rm -rf "$BUILD"' EXIT
case "$(uname -s)" in
    Darwin) LIB="$BUILD/fixture.dylib"; cc -O2 -Wall -Wextra -Werror -dynamiclib "$DIR/../examples/c-interop/demo.c" -o "$LIB" ;;
    Linux) LIB="$BUILD/fixture.so"; cc -O2 -Wall -Wextra -Werror -shared -fPIC "$DIR/../examples/c-interop/demo.c" -o "$LIB" ;;
    *) echo "native fixture supports macOS and Linux" >&2; exit 1 ;;
esac
deno test --allow-read --allow-ffi "$DIR/c-interop-test.ts" -- "$LIB"
