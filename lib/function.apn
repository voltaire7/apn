# Small functions that compose into larger programs.
id x = x
constant x ignored = x
compose f g x = f (g x)
flip f x y = f y x
on f project x y = f (project x) (project y)
apply f x = f x
twice f x = f (f x)
not x = !x
pair x y = [x, y]
fst [x, y] = x
snd [x, y] = y
curry f x y = f [x, y]
uncurry f [x, y] = f x y
