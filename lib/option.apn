import "function"
# Explicit absence and recoverable errors. No exceptions hidden in pipelines.
Option a = Some a | None
Result a e = Ok a | Err e
# Option and Result are functors and monads: Some x and Ok x hold the value;
# None and Err e pass through (return in Option is Some, in Result Ok).
fmap f (Some x) = Some (f x)
fmap f None = None
(Some x) >>= f = f x
None >>= f = None
return x = Option t { Some x }
fmap f (Ok x) = Ok (f x)
fmap f (Err error) = Err error
(Ok x) >>= f = f x
(Err error) >>= f = Err error
return x = Result t e { Ok x }
isSome (Some x) = true
isSome None = false
isNone value = not (isSome value)
withDefault fallback (Some x) = x
withDefault fallback None = fallback
mapOption f (Some x) = Some (f x)
mapOption f None = None
andThen f (Some x) = f x
andThen f None = None
mapResult f (Ok x) = Ok (f x)
mapResult f (Err error) = Err error
mapError f (Ok x) = Ok x
mapError f (Err error) = Err (f error)
andThenResult f (Ok x) = f x
andThenResult f (Err error) = Err error
resultDefault fallback (Ok x) = x
resultDefault fallback (Err error) = fallback
