import "function"
# Explicit absence and recoverable errors. No exceptions hidden in pipelines.
Option a = Some a | None
Result a e = Ok a | Err e
# Option and Result are functors and monads: Some x and Ok x hold the value;
# None and Err e pass through (return in Option is Some, in Result Ok).
map f (Some x) = Some (f x)
map _ None = None
(Some x) >>= f = f x
None >>= _ = None
return = Some
throw _ = None
map f (Ok x) = Ok (f x)
map _ (Err error) = Err error
(Ok x) >>= f = f x
(Err error) >>= _ = Err error
return = Ok
throw = Err
isSome (Some _) = true
isSome None = false
isNone value = not (isSome value)
withDefault _ (Some x) = x
withDefault fallback None = fallback
mapError _ (Ok x) = Ok x
mapError f (Err error) = Err (f error)
resultDefault _ (Ok x) = x
resultDefault fallback (Err _) = fallback
# An Option as a Result: Some x is Ok x; None becomes Err error, naming
# what was missing.
okOr _ (Some x) = Ok x
okOr error None = Err error
# A Result as an Option (Elm's Result.toMaybe): Ok x is Some x, and Err drops
# its error. Other values convert as to Option does for any type.
to Option (Ok x) = Some x
to Option (Err _) = None
# The value inside, or a runtime error when there is none: expect names what
# was missing (and shows an Err's error); unwrap is for quick scripts.
expect _ (Some x) = x
expect message None = fail message
expect _ (Ok x) = x
expect message (Err error) = fail (message ++ ": " ++ to String error)
unwrap (Some x) = x
unwrap None = fail "unwrap: None"
unwrap (Ok x) = x
unwrap (Err error) = fail ("unwrap: " ++ to String (Err error))
