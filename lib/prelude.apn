# The prelude: every binary operator, as an ordinary function bound to its
# symbol, and its fixity. It is in scope everywhere, modules included.
#
# A fixity declaration gives operators a precedence (0, loosest, to 9) and an
# associativity: infixl (left), infixr (right) or infix (none). An operator
# without one is infixl 9. Application binds tighter than any operator, and
# prefix - and ! bind tighter than * but looser than ^.
#
# Operators are functions: (+) is the function, (+ 1) and (1 +) are sections,
# and a + b = ... or (+) = ... defines one. Overloading an existing operator
# with typed clauses is fine; its clauses are tried first, then these:
#     (Money a) + (Money b) = Money (a + b)
# Defining new operators is possible but not recommended: a named function is
# easier to read and to search for.
infixr 0 $
infixl 0 ~
infixl 1 >>= >>
infixr 1 =<<
infixl 2 ||
infixl 3 &&
infixl 4 == != < > <= >= <$> <*>
infixr 4 |
infixr 5 :: &
infixl 6 + - ++
infixl 7 * / %
infixr 8 ^
infixr 9 \

# get v k: what applying a value that is not a function gives: xs 2, r "x",
# assoc "key". Clauses for get extend it, so a type can be indexed:
#     get (Grid cells) [Int r, Int c] = cells (3 * r + c)
get = intrinsics.get
# truthy x: x's truth, which conditions read (c ? a : b, !x, a guard):
# False, zero, empty and null values are False, anything else True.
truthy = intrinsics.truthy
# A guard that always holds: the last of a definition's guards (| else = ...).
else = True
# A Bool applied to two values is one of them: True a b is a, False a b is b
# (c ? a : b is truthy c a b).
get True a = _ -> a
get False _ = b -> b
($) = intrinsics.apply
# x ~ [p -> a, q -> b] matches x: the most specific alternative that fits, as
# among a function's clauses (f p = a; f q = b is f x = x ~ [p -> a, q -> b]).
(~) = intrinsics.match
(||) = intrinsics.or
(&&) = intrinsics.and
(==) = intrinsics.eq
(!=) = intrinsics.ne
(<) = intrinsics.lt
(>) = intrinsics.gt
(<=) = intrinsics.le
(>=) = intrinsics.ge
# A list is Nil or Cons x xs; [] and :: only rearrange how they are written
# ([1,2] is Cons 1 (Cons 2 Nil), x :: xs is Cons x xs).
Nil = []
Cons = intrinsics.cons
(::) = Cons
# Every value is a set: a type its values, a number the numbers below it, a
# list or string its (position, item) pairs, a record its (key, value) pairs.
# a <= b is inclusion ([1] <= [1,2], Int <= Number), a | b the union
# (Int | String; 1 | 2 is 2) and a & b the intersection ([1,2] & [1,3] is [1]).
a | b = intrinsics.union [a,b]
a & b = intrinsics.intersection [a,b]
(+) = intrinsics.add
(-) = intrinsics.sub
(++) = intrinsics.append
(*) = intrinsics.mul
(/) = intrinsics.div
(%) = intrinsics.mod
(^) = intrinsics.pow
(\) = intrinsics.compose
# Prefix - and ! are these functions: -x is negate x, !x is not x.
negate = intrinsics.negate
not x = truthy x False True
# [a..] is enumFrom a, [a,b..] enumFromThen a b, [a..c] enumFromTo a c and
# [a,b..c] enumFromThenTo a b c: numbers count, and a type repeats, [Int..]
# being [Int,Int,Int..], a list that is its own tail. ([] is no bound.)
enumFrom a = intrinsics.range a [] []
enumFrom (t : Type) = {
    ts = t :: ts
    ts
}
enumFromThen a b = intrinsics.range a b []
enumFromTo a c = intrinsics.range a [] c
enumFromThenTo a b c = intrinsics.range a b c
# A list keeps its items as written: it is code, edited as any list is (++
# joins code, an item update replaces an item). probe shows the code, print
# the values; reduce gives the values alone. toAST gives the code as lists
# (see lib/std/syntax.apn).
probe x = print (intrinsics.written x)
reduce xs = map (x -> x) (intrinsics.yields xs)
toAST code = intrinsics.syntax code

# import path: an action reading the module path names (std, std/text, or a
# file or folder beside the program), its record the result. Each module runs
# once: std <- import "std", then [..] = std.[option,text] opens two of them.
import = intrinsics.import
# parse source: the code source writes, its statements as items (in the scope
# parse runs in): code.x reads a binding, [..] = code opens them, do code runs it.
parse = intrinsics.parse
# load file: an action running file.apn beside the running file in a scope of
# its own, again each time it runs, its value (its last statement's) the result.
load file = intrinsics.runFile (file ++ ".apn")

# Functor, Applicative and Monad. IO and lists are built in; any other type
# joins by defining instances of map, >>= and return beside its declaration
# (as the option module does for Option and Result), which travel with it.
#     map f m       m with f applied to what it holds or yields
#     return x      x in the monad the context decides (an annotation, a >>=,
#                   or IO when run)
#     mf <*> mx     the function mf holds applied to what mx holds
#     m >>= f       f applied to what m holds or yields, flattened
#     m >> k        m, then k: m >>= (_ -> k)
(<$>) = map
return = intrinsics.return
# throw e: the monad's failure, decided by the context as return is: [] in a
# list, None in an Option, Err e in a Result, and in IO an action failing
# with e. empty is throw "empty"; guard condition is return [] when it holds,
# else a throw naming the condition: a False guard stops a do-block.
throw = intrinsics.throw
empty = throw "empty"
guard condition = condition ? return [] : throw ("guard failed: " ++ intrinsics.source condition)
(<*>) = intrinsics.ap
# >>= runs an action, and waits on a return no context has decided yet; each
# other monad's are its clauses, f's returns made in that monad.
(>>=) = intrinsics.bind
m >> k = m >>= _ -> k
# f applied to what several values hold, in any monad (Elm's map2 ... map4).
map2 f a b = map f a <*> b
map3 f a b c = map f a <*> b <*> c
map4 f a b c d = map f a <*> b <*> c <*> d
f =<< m = m >>= f
# Monadic values over lists, in any monad: sequence runs each in turn,
# yielding the list of their results (Haskell's); mapM f xs runs f on each
# element; when and unless run an action on a condition. sequence passes on
# what it has so far, so a long list of actions runs in constant stack.
sequence ms = {
    collect [] done = return (done [])
    collect (m :: rest) done = m >>= x -> collect rest (xs -> done (x :: xs))
    collect ms (xs -> xs)
}
mapM f xs = sequence (map f xs)
when condition action = condition ? action >> return [] : return []
unless condition action = condition ? return [] : action >> return []
# loop action runs action forever (until the program exits or is stopped);
# while c action runs it while c, read again before each run, holds.
loop action = action >> loop action
# Representations: to T x writes x as a T, from T x reads it back (to String,
# to JSON, to (List Char); from String parses). They are methods: a program
# adds a type by defining to or from for it beside it, as for map. JSON names
# JSON text, which to JSON writes as a String.
JSON = String
# tag owner ctor fields: a value that ctor made, belonging to owner, which
# patterns of ctor read back (Some a = tag Option Some [a]). A constructor's _
# is one: the value Box x = _ makes for Box 5 is tag Box Box [5].
tag = intrinsics.tag
# with v k x: a copy of v with k set to x; xs 2 = x binds xs to with xs 2 x.
# Clauses for with for a type, beside it, join it, as for get:
#     with (Grid cells) [Int r, Int c] x = Grid (with cells (3 * r + c) x)
with = intrinsics.with
# A list is empty or an element on a list: endless lists, whose unfoldings
# never end, are lists too ([Int..] is Cons Int [Int..]).
List a = Nil | Cons a (List a)
# Whether a value is a list, of any elements, demanding only its first cell.
isList value = value ~ [[] -> True, _ :: _ -> True, _ -> False]
[] >>= f = []
(x :: rest) >>= f = f x ++ (rest >>= f)
# The length-indexed list, the same values: Nil has length zero, and Cons x xs
# one more than xs. A family of lists is a type function's clauses (Vect Z a =
# Nil and Vect (S k) a = Cons a (Vect k a)); any of this shape is the same type.
Vect n a = Nil -> Vect Z a | Cons a (Vect k a) -> Vect (S k) a
