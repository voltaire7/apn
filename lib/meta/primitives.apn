# The object language's explicit host boundary: values and collection operations.
# No source evaluation or syntax inspection is exposed here.
metaPrimitives = HashMap [
    ["^", (^)], ["+", (+)], ["-", (x y -> x - y)], ["*", (*)], ["/", (/)], ["%", (%)],
    ["==", (==)], ["!=", (!=)], ["<", (<)], [">", (>)], ["<=", (<=)], [">=", (>=)],
    ["++", (++)], [":", (x xs -> x : xs)],
    ["not", not], ["head", head], ["tail", tail], ["null", null],
    ["isNumber", isNumber], ["length", length], ["take", take], ["drop", drop],
    ["HashMap", HashMap], ["typeOf", typeOf], ["has", has], ["lookup", lookup], ["insert", insert],
    ["fail", fail], ["seq", seq], ["chars", chars], ["fromChars", fromChars]
]
