# HTTP requests. fetch url options sends one and returns its response, whatever
# its status, as [status: Int, ok: Bool, statusText: String, url: String,
# headers: HashMap, body: String] (headers by lowercase name). options is a
# record of method (default "GET"), headers (a record or HashMap of strings),
# body (a String) and timeout (milliseconds), each optional; [] for none.
# Options and header names are bare keys: [headers: [Content-Type: "..."]].

# The body of a successful (2xx) response; any other status fails.
fetchText url options = {
    response <- fetch url options
    response.ok ? return response.body : fail ("fetch: " ++ response.url ++ " answered "
        ++ to String response.status ++ " " ++ response.statusText)
}
# A successful response's body, decoded as JSON (see the json module).
fetchJson url options = {
    text <- fetchText url options
    return (from JSON text)
}

# Requests as commands, as in Elm's Http: the browser sends them without
# blocking, and the expectation turns the answer into a message.
import "option"
_decode = import "decode"
HttpError = BadUrl String | Timeout | NetworkError | BadStatus Int | BadBody String
HttpEffect = | HttpGet Dynamic Dynamic
get request = HttpGet request.url request.expect
# An expectation: json says whether the body is parsed (as from JSON) first;
# success gets the body, failure the status (0: no answer, -1: not JSON) and why.
failure toMessage status reason = toMessage
    (Err (status == 0 ? NetworkError : status == -1 ? BadBody reason : BadStatus status))
expectString toMessage = [
    json: false
    success: body -> toMessage (Ok body)
    failure: failure toMessage
]
expectJson toMessage decoder = [
    json: true
    success: value -> toMessage (mapError BadBody (_decode.decodeValue decoder value))
    failure: failure toMessage
]
