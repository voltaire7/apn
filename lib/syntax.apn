import ["option","sequence","text"]
# APN's syntax as data. toAST e is the expression e as written, unevaluated;
# fromAST gives an Expr's source; eval evaluates an Expr at the program's top
# level. An operator is an application of its name (a + b is
# Apply (Apply (Name "+") a) b), a pattern is the expression it is written
# as, and a binding is a Bind of its left side, as written, to its right.
Expr =
    | Name String
    | Hole
    | Numeral Number
    | Text String
    | Character Char
    | Boolean Bool
    | Apply Expr Expr
    | Section String Expr
    | Negate Expr
    | Not Expr
    | If Expr Expr Expr
    | Lambda (List Expr) (Option Expr) Expr
    | Items (List Expr)
    | Range Expr (Option Expr) (Option Expr)
    | Fields (List [String,Expr])
    | Field Expr String
    | Select Expr Expr
    | Block (List Expr)
    | Bind Expr Expr
    | Run Expr Expr
    | Import (List String)

toAST = primToAST [
    name: Name, hole: Hole, numeral: Numeral, text: Text, character: Character
    boolean: Boolean, apply: Apply, negate: Negate, not: Not, if: If
    section: Section, lambda: Lambda, items: Items, range: Range, fields: Fields, field: Field
    select: Select, block: Block, bind: Bind, run: Run, imports: Import
    some: Some, none: None
]
eval expression = primEval (fromAST expression)

fromAST expression = String {
    match expression [
        Name name -> _operator name ? "(" ++ name ++ ")" : name
        Hole -> "_"
        Numeral number -> to String number
        Text text -> to String text
        Character c -> to String c
        Boolean b -> to String b
        Apply _ _ -> _application (_spine expression [])
        Section op x -> "(" ++ op ++ " " ++ _operand x ++ ")"
        Negate x -> "-" ++ _operand x
        Not x -> "!" ++ _operand x
        If c yes no -> _operand c ++ " ? " ++ _operand yes ++ " : " ++ _operand no
        Lambda ps guard body -> _items (map _operand ps) ++ _guard guard ++ " -> " ++ fromAST body
        Items xs -> "[" ++ _items (map fromAST xs) ++ "]"
        Range low None high -> "[" ++ _operand low ++ ".." ++ _bound high ++ "]"
        Range low (Some next) high ->
            "[" ++ _items [_operand low, _operand next ++ ".." ++ _bound high] ++ "]"
        Fields fs -> "[" ++ joinWith ", " (map ([key,value] -> key ++ ": " ++ fromAST value) fs)
            ++ "]"
        Field r key -> _operand r ++ "." ++ key
        Select r x -> _operand r ++ "." ++ _selected x
        Block [] -> "{}"
        Block statements -> "{ " ++ joinWith "; " (map fromAST statements) ++ " }"
        Bind left right -> fromAST left ++ " = " ++ fromAST right
        Run left right -> fromAST left ++ " <- " ++ fromAST right
        Import ms -> "import " ++ (length ms == 1 ? to String (head ms)
            : "[" ++ _items (map (to String) ms) ++ "]")
    ]
}

# An application's head and arguments, in order.
_spine (Apply f x) args = _spine f (x :: args)
_spine head args = [head,args]
# An operator given its two operands is written between them.
_application spine = match spine [
    [Name op, [a,b]] | _operator op -> _infixOperand op "left" a ++ " " ++ op ++ " "
        ++ _infixOperand op "right" b
    [head,args] -> joinWith " " (map _operand (head :: args))
]

_guard None = ""
_guard (Some g) = " | " ++ fromAST g
_bound None = ""
_bound (Some high) = _operand high

# An operand of an operator needs no parentheses when it is a call
# (application binds tightest) or an operator binding tighter, or as tight on
# its associativity's side.
_infixOperand outer side expression = match (_spine expression []) [
    [Name op, [_,_]] | _operator op -> _binds outer side op ? fromAST expression
        : "(" ++ fromAST expression ++ ")"
    [_,[]] -> _operand expression
    _ -> fromAST expression
]
_binds outer side inner = {
    [precedence,associativity] = primFixity outer
    [own,_] = primFixity inner
    own > precedence || own == precedence && associativity == side
}# What a selection selects: brackets as written, or a scoped group.
_selected x = match x [
    Items _ -> fromAST x
    Fields _ -> fromAST x
    Block _ -> fromAST x
    _ -> "(" ++ fromAST x ++ ")"
]
# An operand or argument: parenthesized unless it is one piece of syntax.
_operand expression = _atomic expression ? fromAST expression : "(" ++ fromAST expression ++ ")"
_atomic expression = match expression [
    Numeral n -> all (c -> contains c (to (List Char) "0123456789.")) (to (List Char) (to String n))
    Apply _ _ -> false
    Negate _ -> false
    Not _ -> false
    If _ _ _ -> false
    Lambda _ _ _ -> false
    Bind _ _ -> false
    Run _ _ -> false
    Import _ -> false
    _ -> true
]
_operator name = contains (head (to (List Char) name)) (to (List Char) "!$%&*+-/<=>\\^|~:")

# A ',' takes a space only when an item it separates has one (outside string
# and character literals), as the parser requires.
_items xs = joinWith (any _spaced xs ? ", " : ",") xs
_spaced text = _spacedChars (to (List Char) text)
_spacedChars cs = match cs [
    [] -> false
    '"' :: rest -> _spacedChars (_afterString rest)
    '\'' :: _ :: '\'' :: rest -> _spacedChars rest
    c :: rest -> contains c (to (List Char) " \t\n") || _spacedChars rest
]
_afterString cs = match cs [
    [] -> []
    '\\' :: _ :: rest -> _afterString rest
    '"' :: rest -> rest
    _ :: rest -> _afterString rest
]
