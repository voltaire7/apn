import "std/function"
import "std/option"
# Producers and prefix consumers work with infinite lists.
repeat x = x : repeat x
replicate n x = take n (repeat x)
cycle xs = null xs ? [] : xs ++ cycle xs
zip xs ys = zipWith pair xs ys
zipWithIndex xs = zipWith pair [0..] xs
concat xss = foldr (++) [] xss
concatMap f xs = concat (map f xs)
flatten xss = concat xss
sum xs = foldl (+) (Number 0) xs
product xs = foldl (*) (Number 1) xs
contains x xs = any (y -> x == y) xs
findIndex predicate xs = mapOption fst (find (entry -> predicate (snd entry)) (zipWithIndex xs))
headOption xs = null xs ? None : Some (head xs)
lastOption xs = foldl (ignored x -> Some x) None xs
atOption n xs = n < 0 ? None : headOption (drop n xs)
takeUntil predicate xs = takeWhile (x -> not (predicate x)) xs
splitAt n xs = [take n xs,drop n xs]
span predicate xs = [takeWhile predicate xs,dropWhile predicate xs]
chunksOf n xs = n <= 0 ? fail "chunksOf expects a positive size" : null xs ? [] : take n xs : chunksOf n (drop n xs)
intersperse separator xs = null xs ? [] : head xs : foldr (x rest -> separator : x : rest) [] (tail xs)
partition predicate xs = [filter predicate xs,filter (x -> not (predicate x)) xs]
unique xs = null xs ? [] : head xs : unique (filter (x -> x != head xs) (tail xs))
compare x y = x < y ? -1 : x > y ? 1 : 0
sort xs = sortBy compare xs
sortOn project xs = sortBy (on compare project) xs
minimum xs = null xs ? None : Some (foldl min (head xs) (tail xs))
maximum xs = null xs ? None : Some (foldl max (head xs) (tail xs))

# Prepending into a strict left fold reverses in linear time.
reverse (List xs) = foldl (acc x -> x : acc) [] xs
reverse (String text) = fromChars (reverse (chars text))

_prepend x xs = x : xs

# Predicate consumers keep their skipping loop in the primitive lazy filter.
_predicate value = Bool value
dropWhile predicate xs = head (filter (rest -> null rest ? true : not (_predicate (predicate (head rest)))) (iterate tail xs))
takeWhile predicate xs = null xs ? [] : _predicate (predicate (head xs)) ? _prepend (head xs) (takeWhile predicate (tail xs)) : []
all predicate xs = null (dropWhile predicate xs)
any predicate xs = not (all (x -> not (_predicate (predicate x))) xs)
find predicate xs = headOption (dropWhile (x -> not (_predicate (predicate x))) xs)
scanl f seed xs = seed : (null xs ? [] : scanl f (f seed (head xs)) (tail xs))

# Stable merge sort; equal keys always take the earlier (left) element.
_order (Integer value) = value
_order value = fail "sortBy comparator must return an integer"
_mergeSorted compare left right = null left ? right : null right ? left : _order (compare (head left) (head right)) <= 0 ? _prepend (head left) (_mergeSorted compare (tail left) right) : _prepend (head right) (_mergeSorted compare left (tail right))
sortBy compare xs = {
    n = 0 + length xs
    mid = quotient n 2
    n < 2 ? xs : _mergeSorted compare (sortBy compare (take mid xs)) (sortBy compare (drop mid xs))
}

# Force finite accumulator elements between simulation steps, not whole trees.
forceList xs = seq (foldl (ignored x -> seq x []) [] xs) xs
repeatApply n f seed = foldl (value ignored -> f value) seed (take n [0..])
count predicate xs = foldl (n x -> predicate x ? n + 1 : n) 0 xs
