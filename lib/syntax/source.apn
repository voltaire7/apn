# fromAST's printer (lib/syntax.apn loads it): syntax data is lists of mixed
# leaves and nodes, so it runs Dynamic, as the meta reader does. A piece of
# syntax is written for the place it stands in, in parentheses only where it
# would read differently bare there, as the parser requires.
_fromAST syntax = _shown _end syntax

# A place: [kind, minimum, follows]. An "operand" takes an expression whose
# loosest operator binds at least minimum and that takes in no operator of
# precedence follows after it (-1: nothing follows). An "item" is an operand
# in a list, where x, y -> e would be two items; a "guard" one, a lambda's
# guard, holds no lambda. An "argument" takes one piece, a "head" a function
# applied, and "selected" the left of a '.'.
_end = ["operand",0,-1]
_shown place syntax = _fits place syntax ? _bare place syntax : "(" ++ _bare _end syntax ++ ")"
_fits ["argument",_,_] syntax = _kind syntax == "piece" || _kind syntax == "negative"
_fits ["head",_,_] syntax = _kind syntax == "piece" || _kind syntax == "call"
_fits ["selected",_,_] syntax = _kind syntax == "piece" && !_digits syntax
_fits [kind,minimum,follows] syntax = _level syntax >= minimum
    && (follows < 0 || follows < _reach syntax)
    && !(_kind syntax == "lambda" && (kind == "guard" || kind == "item" && _params syntax > 1))
    && !(_kind syntax == "infix" && _fixity (head syntax) == [follows,"none"])

# What a piece of syntax is, as the parser reads it.
_kind (String _) = "piece"
_kind (Bool _) = "piece"
_kind (Number n) = {
    text = to String n
    head (to (List Char) text) == '-' ? "negative" : _digits n ? "piece" : "infix"
}
_kind (function :: args) = contains function ["[]","[:]","{}",".","..","()"] ? "piece"
    : function == "->" ? "lambda"
    : function == "?:" ? "ternary"
    : contains function ["=","<-","import"] ? function
    : _isOperator function && length args == 2 ? "infix"
    : "call"
_digits (Number n) = all (c -> contains c (to (List Char) "0123456789.")) (to (List Char) (to String n))
_digits [".",_,key] = _digits key
_digits (String text) = all (c -> contains c (to (List Char) "0123456789.")) (to (List Char) text)
_digits _ = false
_params [_,params,_] = length params
# The loosest operator a piece of syntax holds at its top, and the loosest one
# after it that it would take in (a lambda takes in everything).
_level syntax = match (_kind syntax) [
    "infix" -> _precedence syntax
    "ternary" -> 1
    _ -> 99
]
_reach syntax = match (_kind syntax) [
    "lambda" -> -1
    "negative" -> 8
    "ternary" -> min 1 (_reach (syntax 3))
    "infix" -> _infixReach syntax
    _ -> 99
]
_infixReach (Number _) = 8
_infixReach [op,_,right] = min (_binding op) (_reach right)
_precedence (Number _) = 7
_precedence (op :: _) = head (_fixity op)
_fixity op = intrinsics.fixity op
# The least precedence an operator's right operand takes.
_binding op = {
    [precedence,associativity] = _fixity op
    associativity == "right" ? precedence : precedence + 1
}

_bare _ (String leaf) = _operator leaf ? "(" ++ leaf ++ ")" : leaf
_bare _ (Bool b) = to String b
_bare _ (Number n) = to String n
_bare place (function :: args) = _node place function args

_node _ "[]" items = "[" ++ _items (map (_shown ["item",0,-1]) items) ++ "]"
_node _ "[:]" fields = "["
    ++ joinWith ", " (map ([key,value] -> key ++ ": " ++ _shown _end value) fields) ++ "]"
_node _ "->" [params,body] = joinWith ", " (map _parameter params) ++ _arrow body
_node [_,_,follows] "?:" [c,yes,no] =
    _shown ["operand",0,1] c ++ " ? " ++ _shown ["operand",1,-1] yes ++ " : "
        ++ _shown ["operand",1,follows] no
_node _ "." [r, (String key)] = _shown ["selected",0,0] r ++ "." ++ key
_node _ "." [r,selected] = _shown ["selected",0,0] r ++ "." ++ _bare _end selected
_node _ "{}" [] = "{}"
_node _ "{}" statements = "{ " ++ joinWith "; " (map (_shown _end) statements) ++ " }"
_node _ ".." [low,high] = "[" ++ _bound low ++ ".." ++ _bound high ++ "]"
_node _ ".." [low,high,next] = "[" ++ _items [_bound low, _bound next ++ ".." ++ _bound high] ++ "]"
_node _ "=" [left,right] = _bare _end left ++ " = " ++ _shown _end right
_node _ "<-" [left,right] = _bare _end left ++ " <- " ++ _shown _end right
_node _ "()" [op,x] = "(" ++ op ++ " " ++ _shown ["operand",8,-1] x ++ ")"
_node _ "import" [m] = "import " ++ to String m
_node _ "import" ms = "import [" ++ _items (map (to String) ms) ++ "]"
_node place function args = length args == 2 && _isOperator function && !_tag function
    ? _infix place function args
    : _application place function args

# A lambda's parameter, a pattern, stands alone unless it is compound.
_parameter syntax = _kind syntax == "piece" ? _bare _end syntax : "(" ++ _bare _end syntax ++ ")"
# A lambda's body, after its guard if it has one.
_arrow ["|",guard,body] = " | " ++ _shown ["guard",0,-1] guard ++ " -> " ++ _shown _end body
_arrow body = " -> " ++ _shown _end body
_bound [] = ""
_bound syntax = _shown ["operand",6,-1] syntax

# An operator between its operands: the left one takes in nothing up to the
# operator, the right one binds at least as tightly as the operator takes.
_infix [_,_,follows] op [a,b] = {
    precedence = head (_fixity op)
    _shown ["operand",0,precedence] a ++ " " ++ op ++ " " ++ _shown ["operand", _binding op, follows] b
}
# A call: the function, then its arguments, each one piece (a lambda among
# them parenthesized).
_application _ function args =
    joinWith " " (_shown ["head",0,-1] function :: map (_shown ["argument",0,-1]) args)
_isOperator (String name) = _operator name
_isOperator _ = false
# The heads that are syntax, not functions.
_tag head = contains head ["[]","[:]","->","?:",".","{}","..","=","<-","()","import","|"]
_operator name = contains (head (to (List Char) name)) (to (List Char) "!$%&*+-/<=>\\^|~:")

# A ',' takes a space only when an item it separates has one (outside string
# and character literals), as the parser requires.
_items xs = joinWith (any _spaced xs ? ", " : ",") xs
_spaced text = _spacedChars (to (List Char) text)
_spacedChars cs = match cs [
    [] -> false
    '"' :: rest -> _spacedChars (_afterString rest)
    '\'' :: _ :: '\'' :: rest -> _spacedChars rest
    c :: rest -> contains c (to (List Char) " \t\n") || _spacedChars rest
]
_afterString cs = match cs [
    [] -> []
    '\\' :: _ :: rest -> _afterString rest
    '"' :: rest -> rest
    _ :: rest -> _afterString rest
]
