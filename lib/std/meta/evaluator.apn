# Metacircular core. No host eval, parse, toAST, or interpreter callback.
# Syntax is toAST's lists: a leaf is a number, a Bool, a name or a string
# literal's quoted source; [function, arguments...] applies; other syntax is
# headed by a tag: ["->",params,body], ["?:",c,a,b], ["[]",...], [".",f,input],
# ["$",f,x], [":",x,T] and ["{}",...], whose ["=",left,right] statements bind recursively.
# Environments are persistent maps of lazy values.
meCons x xs = x :: xs
# (A name is text, and text is a list: it is tested first.)
meEval scope expression = typeOf expression == typeOf "text"
    ? meLeaf scope expression
    : (isList expression
    ? meNode scope (head expression) (tail expression)
    : expression)
# (The meta reader has no character literals: a Char is a string's head.)
meQuote = head "\""
meLeaf scope text = head text == meQuote
    ? (meUnescape (meInner text) : String)
    : lookup text scope
meInner chars = take (length chars - 2) (tail chars)
meBackslash = head "\\"
meUnescape chars = null chars
    ? []
    : (head chars == meBackslash
    ? meCons (meEscape (head (tail chars))) (meUnescape (tail (tail chars)))
    : meCons (head chars) (meUnescape (tail chars)))
meEscape c = c == head "n" ? head "\n" : (c == head "t" ? head "\t" : (c == head "r" ? head "\r" : c))
meNode scope tag arguments = typeOf tag == typeOf "text"
    ? (has tag meForms
        ? lookup tag meForms scope arguments
        : meApplyAll (meEval scope tag) (meList scope arguments))
    : meApplyAll (meEval scope tag) (meList scope arguments)
meForms = insert [["$",mePipe],["{}",meBlock],[":",meAscription]]
    ([["->",meLambda],["?:",meIf],["[]",meList]] : HashMap _ _)
meAscription scope arguments = meEval scope (head arguments) : meEval scope (arguments 1)
meLambda scope arguments = meClosure (head arguments) (arguments 1) scope
meIf scope arguments = meEval scope (head arguments)
    ? meEval scope (arguments 1)
    : meEval scope (arguments 2)
meList scope expressions = null expressions
    ? []
    : meCons (meEval scope (head expressions)) (meList scope (tail expressions))
mePipe scope arguments = meApply (meEval scope (head arguments)) (meEval scope (arguments 1))
meApplyAll function arguments = null arguments
    ? function
    : meApplyAll (meApply function (head arguments)) (tail arguments)
# A block: its bindings, recursively in scope, then its last statement's value.
meBlock scope statements = null statements
    ? []
    : meLast (meScope statements scope) statements
meLast scope statements = null (tail statements)
    ? (meBinding (head statements)
        ? lookup (meName (head statements 1)) scope
        : meEval scope (head statements))
    : meLast scope (tail statements)
meBinding statement = isList statement ? head statement == "=" : False
meName left = typeOf left == typeOf "text" ? left : head left
meValue left right = typeOf left == typeOf "text" ? right : ["->", tail left, right]
meBindings statements scope = null statements
    ? []
    : (meBinding (head statements)
    ? meCons (meBound scope (head statements)) (meBindings (tail statements) scope)
    : meBindings (tail statements) scope)
meBound scope binding = [meName (binding 1), meEval scope (meValue (binding 1) (binding 2))]
meScope statements parent = {
    scope = [insert (meBindings statements (head scope)) parent]
    head scope
}
meClosure parameters body scope : HashMap _ _ = [["__closure", True], ["parameters",parameters]]
    ++ [["body",body],["scope",scope]]
# A closure takes its parameters one at a time.
meApply function argument = isType (HashMap _ _) function
    ? (has "__closure" function
        ? meEnter (lookup "parameters" function) (lookup "body" function)
            (insert [[head (lookup "parameters" function), argument]] (lookup "scope" function))
        : function argument)
    : function argument
meEnter parameters body scope = null (tail parameters)
    ? meEval scope body
    : meClosure (tail parameters) body scope
