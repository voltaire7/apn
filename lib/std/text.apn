std <- import "std"
[..] = std.[sequence,function,option]

# Unicode WhiteSpace plus line terminators (the same set as ECMAScript \s).
isSpace c = contains c " \t\n\r\v\f                 　﻿"
[
    upper = upper
    lower = lower
    # Strings reverse as lists do (sequence's reverse, by code point).
    reverse = reverse

    # Unicode code-point operations: a String is its characters, astral ones too.
    textLength text = length text
    textTake n text = (take n text : String)
    textDrop n text = (drop n text : String)
    isBlank text = trim text == ""
    lines text = splitOn "\n" text
    unlines xs = joinWith "\n" xs
    unwords xs = joinWith " " xs
    startsWith prefix text = take (length prefix) text == prefix
    endsWith suffix text =
        length suffix <= length text && drop (length text - length suffix) text == suffix

    # Literal splitting scans once, keeping the current field backwards.
    splitOn delimiter text = delimiter == ""
        ? map (c -> ([c] : String)) text
        : {
            # (Its characters as a plain list: reversed as one, its length known.)
            marker = reverse (to (List Char) delimiter)
            width = 0 + length marker
            step state c = {
                current = c :: snd state
                take width current == marker
                    ? [prepend (reverse (drop width current) : String) (fst state), []]
                    : [fst state, current]
            }
            state = foldl step [[],[]] text
            reverse ((reverse (snd state) : String) :: fst state)
        }
    # Joined as strings, not characters: a string's ++ is one step.
    joinWith delimiter xs = {
        xs ~ [
            [] -> ""
            first :: rest -> foldl (joined, x -> joined ++ delimiter ++ x) first rest
        ]
    } : String
    replaceAll search replacement text = joinWith replacement (splitOn search text)

    words text = filter (x -> x != "")
        (splitOn " " (map (c -> isSpace c ? ' ' : c) text))
    trim text = (reverse (dropWhile isSpace (reverse (dropWhile isSpace text))) : String)

    # Common puzzle-input shapes; CRLF and trailing blank lines are accepted.
    nonEmptyLines text = filter (line -> line != "") (map trim (lines text))
    parseInt (text : String) = {
        [value] = [(from String text : Dynamic)]
        isInteger value && isExact (value : Number)
            ? (value : Int)
            : fail "parseInt expects an exact integer"
    }
    integers text = map parseInt (words text)
]
