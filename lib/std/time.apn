# Time, as in Elm's Time: a Posix is milliseconds since 1970 (UTC), a Zone an
# offset from UTC in minutes. now and here are actions (tasks); every is a
# subscription. currentTime and zoneOffset are the natives they read.
# (Constructors have their own names: a type's name is the type.)
Posix = | PosixMillis Int
Zone = | ZoneOffset Int
utc = ZoneOffset 0
millisToPosix ms = PosixMillis ms
posixToMillis (PosixMillis ms) = ms
now = map PosixMillis currentTime
here = map ZoneOffset zoneOffset
TimeEffect = | TimeEvery Dynamic Dynamic
every interval toMessage = TimeEvery interval (ms -> toMessage (PosixMillis ms))
# Milliseconds since midnight... in a zone: the parts of the time of day.
localMillis (ZoneOffset offset) (PosixMillis ms) = ms + offset * 60000
toHour zone time = modulo (quotient (localMillis zone time) 3600000) 24
toMinute zone time = modulo (quotient (localMillis zone time) 60000) 60
toSecond zone time = modulo (quotient (localMillis zone time) 1000) 60
toMillis zone time = modulo (localMillis zone time) 1000
