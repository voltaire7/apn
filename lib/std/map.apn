std <- import "std"
[..] = std.[sequence,function,option]

insertCombined combine acc [key,value] =
    insert [[key, has key acc ? combine (lookup key acc) value : value]] acc
[
    # Persistent map transformations. Input maps are never modified.
    getOption key m = has key m ? Some (lookup key m) : None
    getOr fallback key m = has key m ? lookup key m : fallback
    insertWith combine entries m = foldl (insertCombined combine) m entries
    update key f m = has key m ? insert [[key, f (lookup key m)]] m : m
    mapValues f m : HashMap _ _ = map ([key,value] -> [key, f value]) (pairs m)
    filterMap predicate m : HashMap _ _ = filter ([key,value] -> predicate key value) (pairs m)
    merge left right = insert (pairs right) left
    mergeWith combine left right = insertWith combine (pairs right) left
    frequencies xs = {
        increment m x = {
            count = getOr 0 x m + 1
            seq count (insert [[x,count]] m)
        }
        foldl increment ([] : HashMap _ _) xs
    }
    groupBy project xs = mapValues reverse
        (foldl (m, x -> insertWith (old, new -> new ++ old) [[project x, [x]]] m)
            ([] : HashMap _ _) xs)
]
