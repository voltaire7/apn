# Decoding JSON values, as in Elm's Json.Decode. A decoder turns a value (as
# from JSON gives it: an object's [key,value] pairs, lists, numbers, strings,
# Bool, []) into Ok of the result or Err of what went wrong. A type decodes as
# fromType reads it, so one stands wherever a decoder goes (field "year" Int,
# list Quote). int, float and list are also random's names: a program using
# both imports one qualified (decode <- import "std/decode").
[..] <- import "std/option"
# The value an object (its [key,value] pairs) holds under name, or the error
# saying it has none.
fieldValue name value = {
    named [(key : String), _] = key == name
    named _ = False
    found = isType (List _) value ? filter named value : []
    null found ? Err ("Expecting an OBJECT with a field named `" ++ name ++ "`" : String) : Ok (head found 1)
}
# The values of a list of Results, or the first error.
allOk results = results ~ [
    [] -> Ok []
    result :: rest -> map2 (x, xs -> x :: xs) result (allOk rest)
]
# What the module's names share with each other: opened here, and joined to
# the record it gives (shared ++ [...]).
shared.[..] = [
    Decoder a = | Decoder (value -> Result a String)
    expecting what test = Decoder (value -> test value ? Ok value : Err ("Expecting " ++ what : String))
    string = expecting "a STRING" (isType String)
    int = expecting "an INT" isInteger
    float = Decoder (value -> isNumber value ? Ok (inexact value) : Err "Expecting a FLOAT")
    bool = expecting "a BOOL" (isType Bool)
    # Decoders are monads: map f d, d >>= f (Elm's andThen), return x (Elm's
    # succeed); map2 ... map4 come from the prelude.
    map f (Decoder decoder) = Decoder (value -> decoder value ~ [
        Ok x -> Ok (f x)
        Err error -> Err error
    ])
    Decoder decoder >>= f = Decoder (value -> decoder value ~ [
        Ok x -> decodeValue (f x) value
        Err error -> Err error
    ])
    return x = Decoder (_ -> Ok x)
    # A value as a decoder or a type describes it, as Dynamic so one function
    # decodes them all: a record schema field by field (to Record of its keys
    # paired with their values), String, Int, Float and Bool as string, int,
    # float and bool, and any other type the values isType accepts.
    decodeValue (Decoder decoder) value = decoder value
    # (A schema's fields decode as Dynamic: they may differ in type.)
    decodeValue (schema : Record) value = map
        (values -> to Record (zipWith (key, v -> [key,v]) (map head (pairs schema)) values))
        (allOk (map ([name,t] -> fieldValue name value
            >>= found -> map (v -> (v : Dynamic)) (decodeValue t found)) (pairs schema)))
    decodeValue (t : Type) value = decodeValue (t == String ? string : (t == Int ? int
        : (t == Float ? float : (t == Bool ? bool : expecting (to String t) (isType t))))) value
]
shared ++ [
    # A type's decoder, for what takes only a decoder (map f (fromType Quote)), or
    # a record's whose fields may be decoders ([name : String, tags = list string]).
    fromType t = Decoder (decodeValue t)
    succeed x = Decoder (_ -> Ok x)
    field name decoder = Decoder (value -> fieldValue name value >>= decodeValue decoder)
    at path decoder = path ~ [
        [] -> Decoder (decodeValue decoder)
        name :: rest -> field name (at rest decoder)
    ]
    list decoder = Decoder (value ->
        isType (List _) value ? allOk (map (decodeValue decoder) value) : Err "Expecting a LIST")
]
