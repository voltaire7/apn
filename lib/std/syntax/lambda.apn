# toLambda's desugarer (lib/syntax.apn loads it, Dynamic, as the printer is):
# syntax data to a core of names, literals, one-parameter lambdas and
# application. A block's binding x = e; rest is (x -> rest) e, so a later
# binding of x is an inner lambda shadowing it; a binding that refers to
# itself is a fixed point (Curry's Y); a definition with several clauses, or
# patterns for parameters, a match over its arguments; x <- e; rest is
# e >>= (x -> rest), and an action statement s; rest is s >> rest. A list's
# bindings scope over its later items as a block's do. Other syntax (?:,
# lists, records, ranges, patterns) stays, its parts desugared.
[..] <- import "std/sequence"
[..] <- import "std/text"
[..] <- import "std/function"
[..] <- import "std/option"
lambda bound (leaf : String) = leaf
lambda bound (b : Bool) = b
lambda bound (n : Number) = n
lambda bound [] = []
lambda bound (head :: rest) = core bound head rest

core bound "->" [params,body] = curried bound params body
core bound "{}" [] = ["{}"]
core bound "{}" statements = block bound statements
core bound "()" [op,x] = ["->", ["_1"], [op, "_1", lambda bound x]]
core bound "$" [f,x] = [lambda bound f, lambda bound x]
core bound "=" [left,right] = ["=", bindingPattern left, valueOf bound [["=",left,right]]]
core bound "[]" items = any isBinding items
    ? "[]" :: listItems bound [] items
    : map (lambda bound) ("[]" :: items)
core bound head args = map (lambda bound) (head :: args)

# A list with bindings: its bindings scope over its later items, so each
# other item is the block of the bindings before it, ending in the item:
# [x = 1, x + 1] is [(x -> x + 1) 1], [x <- m, f x] is [m >>= x -> f x].
listItems _ _ [] = []
listItems bound before (item :: rest) = isBinding item
    ? listItems bound (before ++ [item]) rest
    : block bound (before ++ [item]) :: listItems bound before rest
isBinding ["=",_,_] = True
isBinding ["<-",_,_] = True
isBinding _ = False

# One lambda per parameter; a guard stays on the last.
curried bound [param] body = ["->", [param], lambda (binders param ++ bound) body]
curried bound (param :: params) body =
    ["->", [param], curried (binders param ++ bound) params body]

# A block: each statement takes the rest of the block as its body.
block bound [statement] = last bound statement
block bound (["=",left,right] :: rest) = {
    [clauses,after] = clausesOf left right rest
    pattern = bindingPattern left
    null after ? valueOf bound clauses
        : [["->", [pattern], block (binders pattern ++ bound) after], valueOf bound clauses]
}
block bound (["<-",left,right] :: rest) =
    [">>=", lambda bound right, ["->", [left], block (binders left ++ bound) rest]]
block bound (statement :: rest) = [">>", lambda bound statement, block bound rest]
# A block's last statement is its value; a last binding gives the bound value.
last bound ["=",left,right] = valueOf bound (head (clausesOf left right []))
last bound statement = lambda bound statement

# A definition's clauses: f's consecutive clauses, and the statements after.
clausesOf left right rest = isDefinition left
    ? [
        ["=",left,right] :: takeWhile (sameDefinition (head left)) rest
        dropWhile (sameDefinition (head left)) rest
    ]
    : [[["=",left,right]],rest]
sameDefinition name ["=", other :: _, _] = other == name
sameDefinition _ _ = False
isDefinition (name :: _) = isName name
isDefinition _ = False

# The value a binding's clauses give, a fixed point when it refers to itself.
valueOf bound clauses = {
    name = nameOf (head clauses 1)
    value = definition (name :: bound) clauses
    isName name && !contains name bound && mentions name value
        ? [fixedPoint, ["->", [name], value]]
        : value
}
definition bound [["=",left,right]] = isDefinition left
    ? function bound [[tail left, right]]
    : lambda bound right
definition bound clauses =
    function bound (map (["=",left,right] -> [tail left, right]) clauses)
# One clause of plain names is a curried lambda; anything else matches its
# arguments: f (Some x) y = ... is _1 -> _2 -> ([_1,_2] ~ [[Some x, y] -> ...]).
function bound [[params,body]] = all isPlain params
    ? curried bound params body
    : matching bound [[params,body]]
function bound clauses = matching bound clauses
matching bound clauses = {
    arity = length (head (head clauses))
    names = map (n -> "_" ++ to String n) [1..arity]
    one = arity == 1
    subject = one ? head names : "[]" :: names
    cases = map ([params,body] -> ["->", [one ? head params : "[]" :: params], body]) clauses
    curried bound names ["~", subject, "[]" :: cases]
}
fixedPoint = ["->", ["f"], [["->", ["x"], ["f", ["x","x"]]], ["->", ["x"], ["f", ["x","x"]]]]]

# What a binding binds: its name, or the pattern it takes apart.
bindingPattern left = isDefinition left ? head left : left
nameOf (name : String) = name
nameOf (name :: _) = isName name ? name : ""
binders (name : String) = isName name ? [name] : []
binders (first :: rest) =
    foldr (pattern, names -> binders pattern ++ names) [] (first :: rest)
binders _ = []
isPlain (name : String) = isName name
isPlain _ = False
isName name = name != "" && name != "_" && contains (head (to (List Char) name)) nameStarts
nameStarts = to (List Char) "abcdefghijklmnopqrstuvwxyz_"
mentions name (leaf : String) = leaf == name
mentions name (first :: rest) = any (mentions name) (first :: rest)
mentions _ _ = False
[desugared = lambda]
