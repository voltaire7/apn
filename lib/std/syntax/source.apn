# fromAST's printer (lib/syntax.apn loads it): syntax data is lists of mixed
# leaves and nodes, so it runs Dynamic, as the meta reader does. A piece of
# syntax is written for the place it stands in, in parentheses only where it
# would read differently bare there, as the parser requires.
std <- import "std"
[..] = std.[sequence,text,function,option]
fromAST syntax = shown end syntax

# A place: [kind, minimum, follows]. An "operand" takes an expression whose
# loosest operator binds at least minimum and that takes in no operator of
# precedence follows after it (-1: nothing follows). An "item" is an operand
# in a list, where x, y -> e would be two items; a "guard" one, a lambda's
# guard, holds no lambda. An "argument" takes one piece, a "head" a function
# applied, and "selected" the left of a '.'.
end = ["operand", 0, -1]
shown place syntax = fits place syntax ? bare place syntax : "(" ++ bare end syntax ++ ")"
fits ["argument",_,_] syntax = kindOf syntax == "piece" || kindOf syntax == "negative"
fits ["head",_,_] syntax = kindOf syntax == "piece" || kindOf syntax == "call"
fits ["selected",_,_] syntax = kindOf syntax == "piece" && !digits syntax
fits [kind,minimum,follows] syntax = level syntax >= minimum
    && (follows < 0 || follows < reach syntax)
    && !(kindOf syntax == "lambda" && (kind == "guard" || kind == "item" && paramCount syntax > 1))
    && !(kindOf syntax == "infix" && fixity (head syntax) == [follows,"none"])

# What a piece of syntax is, as the parser reads it.
kindOf (_ : String) = "piece"
kindOf (_ : Bool) = "piece"
kindOf (n : Number) = {
    text = to String n
    head text == '-' ? "negative" : (digits n ? "piece" : "infix")
}
kindOf (function :: args) = contains function ["[]","[:]","{}",".","..","()",":"] ? "piece"
    : (function == "->" ? "lambda"
    : (function == "?:" ? "ternary"
    : (contains function ["=","<-","[..]"] ? function
    : (isOperator function && length args == 2 ? "infix"
    : "call"))))
digits (n : Number) = all digit (to String n)
digits [".",_,key] = digits key
digits (text : String) = all digit text
digits _ = False
paramCount [_,params,_] = length params
# The loosest operator a piece of syntax holds at its top, and the loosest one
# after it that it would take in (a lambda takes in everything).
level syntax = kindOf syntax ~ [
    "infix" -> precedenceOf syntax
    "ternary" -> 1
    _ -> 99
]
reach syntax = kindOf syntax ~ [
    "lambda" -> -1
    "negative" -> 8
    "ternary" -> min 1 (reach (syntax 3))
    "infix" -> infixReach syntax
    _ -> 99
]
infixReach (_ : Number) = 8
infixReach [op,_,right] = min (binding op) (reach right)
precedenceOf (_ : Number) = 7
precedenceOf (op :: _) = head (fixity op)
fixity op = intrinsics.fixity op
# The least precedence an operator's right operand takes.
binding op = {
    [precedence,associativity] = fixity op
    associativity == "right" ? precedence : precedence + 1
}

bare _ (leaf : String) = operator leaf ? "(" ++ leaf ++ ")" : leaf
bare _ (b : Bool) = to String b
bare _ (n : Number) = to String n
bare place (function :: args) = node place function args

node _ "[]" items = "[" ++ listed (map (shown ["item", 0, -1]) items) ++ "]"
node _ "[:]" fields = "["
    ++ joinWith ", " (map ([key,value] -> key ++ " = " ++ shown end value) fields) ++ "]"
node _ "->" [params,body] = joinWith ", " (map parameter params) ++ arrow body
node [_,_,follows] "?:" [c,yes,no] =
    branch ["operand", 0, 1] c ++ " ? " ++ branch ["operand", 1, -1] yes ++ " : "
        ++ branch ["operand", 1, follows] no
node _ "." [r, (key : String)] = shown ["selected", 0, 0] r ++ "." ++ key
node _ "." [r,selected] = shown ["selected", 0, 0] r ++ "." ++ bare end selected
# An ascription, (x : T), in its own parentheses.
node _ ":" [value,type] = "(" ++ shown ["guard", 0, -1] value ++ " : " ++ shown end type ++ ")"
node _ "{}" [] = "{}"
node _ "{}" statements = "{ " ++ joinWith "; " (map (shown end) statements) ++ " }"
node _ ".." [low,high] = "[" ++ bound low ++ ".." ++ bound high ++ "]"
node _ ".." [low,high,next] = "[" ++ listed [bound low, bound next ++ ".." ++ bound high] ++ "]"
node _ "=" [left,right] = bare end left ++ " = " ++ shown end right
node _ "<-" [left,right] = bare end left ++ " <- " ++ shown end right
node _ "[..]" [value] = "[..] = " ++ shown end value
node _ "()" [op,x] = "(" ++ op ++ " " ++ shown ["operand", 8, -1] x ++ ")"
node place function args = length args == 2 && isOperator function && !isTag function
    ? infixed place function args
    : application place function args

# A ternary inside a ternary is parenthesized: c ? (d ? 1 : 2) : 3.
branch place syntax = kindOf syntax == "ternary" ? "(" ++ bare end syntax ++ ")" : shown place syntax
# A lambda's parameter, a pattern, stands alone unless it is compound.
parameter syntax = kindOf syntax == "piece" ? bare end syntax : "(" ++ bare end syntax ++ ")"
# A lambda's body, after its guard if it has one.
arrow ["|",guard,body] = " | " ++ shown ["guard", 0, -1] guard ++ " -> " ++ shown end body
arrow body = " -> " ++ shown end body
bound [] = ""
bound syntax = shown ["operand", 6, -1] syntax

# An operator between its operands: the left one takes in nothing up to the
# operator, the right one binds at least as tightly as the operator takes.
infixed [_,_,follows] op [a,b] = {
    precedence = head (fixity op)
    shown ["operand", 0, precedence] a ++ " " ++ op ++ " " ++ shown ["operand", binding op, follows] b
}
# A call: the function, then its arguments, each one piece (a lambda among
# them parenthesized).
application _ function args =
    joinWith " " (shown ["head", 0, -1] function :: map (shown ["argument", 0, -1]) args)
isOperator (name : String) = operator name
isOperator _ = False
# The heads that are syntax, not functions.
isTag head = contains head ["[]","[:]","->","?:",".","{}","..","=","<-","[..]","()","|",":"]
operator name = contains (head name) "!$%&*+-/<=>\\^|~:"

# A ',' takes a space only when an item it separates has one (outside string
# and character literals) or two are literals of different kinds (["a", 1],
# [[1], 2]; numbers are one kind), as the parser requires.
listed xs = joinWith (any spaced xs || length (unique (filter (!= "") (map literal xs))) > 1
    ? ", " : ",") xs
literal text = literalChars text
literalChars cs = cs ~ [
    '"' :: rest -> afterString rest == [] ? "string" : ""
    '\'' :: _ -> "char"
    '[' :: _ -> head (reverse cs) == ']' ? "list" : ""
    '-' :: c :: _ -> digit c ? "number" : ""
    c :: _ -> digit c ? "number" : (contains cs ["True","False"] ? "Bool" : "")
    [] -> ""
]
digit c = contains c "0123456789."
spaced text = spacedChars text
spacedChars cs = cs ~ [
    [] -> False
    '"' :: rest -> spacedChars (afterString rest)
    '\'' :: _ :: '\'' :: rest -> spacedChars rest
    c :: rest -> contains c " \t\n" || spacedChars rest
]
afterString cs = cs ~ [
    [] -> []
    '\\' :: _ :: rest -> afterString rest
    '"' :: rest -> rest
    _ :: rest -> afterString rest
]
[written = fromAST]
