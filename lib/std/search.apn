maps <- import "std/map"
sequences <- import "std/sequence"
functions <- import "std/function"
option <- import "std/option"
use [maps,sequences,functions,option]
[
    # Breadth-first traversal with level frontiers; keys must be HashMap scalar keys.
    # Mark on insertion so cycles and duplicate edges cannot enqueue a node twice.
    bfsDistances neighbors starts = {
        initial = [
            frontier = unique starts
            distances = (map (x -> [x,0]) starts : HashMap _ _)
            depth = 0
        ]
        step state = {
            depth = state.depth + 1
            seq depth []
            visit acc node = has node (fst acc)
                ? acc
                : [insert [[node,depth]] (fst acc), prepend node (snd acc)]
            [next] = [foldl visit [state.distances,[]] (concatMap neighbors state.frontier)]
            seq (fst next)
                (seq (snd next)
                    [frontier = reverse (snd next), distances = fst next, depth = depth])
        }
        [finished] = [head (filter (state -> null state.frontier) (iterate step initial))]
        finished.distances
    }
]
