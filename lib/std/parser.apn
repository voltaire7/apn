# Parsers, as Haskell's Parsec: a parser reads the start of its input and
# gives Ok of its value and the rest, or Err of what it expected. Parsers are
# monads, so a do-block reads its input in order:
#     date = { y <- number; char '-'; m <- number; return [y,m] }
#     parse date "2026-10" is Ok [2026,10]
# The input is a list (a string is its characters), so a list of anything
# parses, code included. Its names repeat others' (string, as decode's): a
# program using both imports one qualified (parser <- import "std/parser").
std <- import "std"
[..] = std.[option,sequence,function]

# What the module's names share with its helpers: opened here, and joined to
# the record it gives (shared ++ [...]).
shared.[..] = [Parser a = | Parser (input -> Result [a,input] String)]
run (Parser p) input = p input
shown = to String
digitValue d = length (takeWhile (!= d) "0123456789")
# The items p reads, as many as it can, after these, and the rest of the input.
# It reads in a loop, in constant stack, so long input parses.
readMany p input items = readNext p (run p input) input items
readNext p (Ok [x,rest]) _ items = readMany p rest (x :: items)
readNext _ (Err _) input items = [items = reverse items, rest = input]
shared ++ [
    # Ok of the value a parser reads from all of the input, or Err (a String
    # is read as its characters, which it is).
    parse parser text = run parser text ~ [
        Ok [value,[]] -> Ok value
        Ok [_, next :: _] -> Err ("unexpected " ++ shown next)
        Err message -> Err message
    ]

    map f (Parser p) = Parser (input -> p input ~ [
        Ok [value,rest] -> Ok [f value, rest]
        Err message -> Err message
    ])
    Parser p >>= f = Parser (input -> p input ~ [
        Ok [value,rest] -> run (f value) rest
        Err message -> Err message
    ])
    return x = Parser (input -> Ok [x,input])

    # One item, if test accepts it.
    satisfy what test = Parser (input -> input ~ [
        x :: rest | test x -> Ok [x,rest]
        x :: _ -> Err ("expected " ++ what ++ ", got " ++ shown x)
        [] -> Err ("expected " ++ what ++ ", got the end")
    ])
    item = satisfy "an item" (_ -> True)
    char c = satisfy (shown c) (== c)
    oneOf cs = satisfy ("one of " ++ cs) (c -> contains c cs)
    string text = {
        chars cs = cs ~ [
            [] -> return text
            c :: rest -> {
                char c
                chars rest
            }
        ]
        chars text
    }
    digit = oneOf "0123456789"
    letter = satisfy "a letter" (c -> c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z')
    space = oneOf " \t\n\r"
    end = Parser (input -> null input ? Ok [[],input]
        : Err ("expected the end, got " ++ shown (head input)))

    # p, or q if p fails.
    infixr 3 <|>
    Parser p <|> q = Parser (input -> p input ~ [
        Ok result -> Ok result
        Err _ -> run q input
    ])
    # p read as many times as it can (some: at least once).
    many p = Parser (input -> {
        read = readMany p input []
        Ok [read.items,read.rest]
    })
    some p = Parser (input -> run p input ~ [
        Ok [x,rest] -> {
            read = readMany p rest [x]
            Ok [read.items,read.rest]
        }
        Err message -> Err message
    ])
    optional p = map Some p <|> return None
    # p's, separated by sep's.
    sepBy p sep = sepBy1 p sep <|> return []
    sepBy1 p sep = {
        x <- p
        xs <- many { sep; p }
        return (x :: xs)
    }
    spaces = many space
    # A whole number, from its digits.
    number = map (ds -> foldl (n, d -> n * 10 + digitValue d) 0 ds) (some digit)
    # p, and the spaces after it.
    token p = {
        x <- p
        spaces
        return x
    }
]
