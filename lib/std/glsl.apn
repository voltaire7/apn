# GLSL expressions as values, for writing a shader's code in APN (as
# p5.strands writes it in JavaScript): arithmetic and the math functions on
# them write GLSL. A number joins in as a float, and a list as a vector.
std <- import "std"
use std.text
Glsl = | MkGlsl String

# A value's GLSL code.
glsl (MkGlsl code) = code
glsl (items : List _) = "vec" ++ to String (length items) ++ "(" ++ joinWith ", " (map glsl items)
    ++ ")"
glsl (n : Number) = to String (n : Float)

# A list as one GLSL vector, for arithmetic as a whole: vec [x,y] * 0.5.
vec items = MkGlsl (glsl items)
# A GLSL function applied to its arguments: call "mix" [a,b,0.5].
call name arguments = MkGlsl (name ++ "(" ++ joinWith ", " (map glsl arguments) ++ ")")
_binary operator a b = MkGlsl ("(" ++ glsl a ++ " " ++ operator ++ " " ++ glsl b ++ ")")
MkGlsl a + b = _binary "+" (MkGlsl a) b
a + MkGlsl b = _binary "+" a (MkGlsl b)
MkGlsl a - b = _binary "-" (MkGlsl a) b
a - MkGlsl b = _binary "-" a (MkGlsl b)
MkGlsl a * b = _binary "*" (MkGlsl a) b
a * MkGlsl b = _binary "*" a (MkGlsl b)
MkGlsl a / b = _binary "/" (MkGlsl a) b
a / MkGlsl b = _binary "/" a (MkGlsl b)
sin (MkGlsl x) = call "sin" [MkGlsl x]
cos (MkGlsl x) = call "cos" [MkGlsl x]
sqrt (MkGlsl x) = call "sqrt" [MkGlsl x]
abs (MkGlsl x) = call "abs" [MkGlsl x]
floor (MkGlsl x) = call "floor" [MkGlsl x]
min (MkGlsl a) b = call "min" [MkGlsl a, b]
max (MkGlsl a) b = call "max" [MkGlsl a, b]
# GLSL's own functions.
fract x = call "fract" [x]
distance a b = call "distance" [a,b]
mix a b amount = call "mix" [a,b,amount]
# Some of a vector's components: swizzle "r" color, swizzle "xy" position.
swizzle components vector = MkGlsl (glsl vector ++ "." ++ components)
# A texture's color at a point (sampler is a texture's name).
getTexture sampler point = call "TEXTURE" [sampler,point]
