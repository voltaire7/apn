import "std"

# Infinite streams, finite answers.
print (take 12 primes)
print (take 15 fibonacci)
print (take 8 (scanl (+) 0 [1..]))

# Statistics preserve exact fractions. Empty samples return None.
measurements = [2, 4, 4, 4, 5, 5, 7, 9]
print (mean measurements)               # Some 5
print (variance measurements)           # Some 4
print (median measurements)             # Some 9/2
print (mean [])                         # None

# A word-frequency leaderboard, with stable tie ordering.
poem = "Time flies like an arrow fruit flies like a banana"
leaderboard = poem $ lower $ words $ frequencies $ pairs $ sortOn (entry -> -(snd entry))
leaderboard * [word, count] -> {
    print (format "%: %" [word, count])
}

# Persistent grouping: original encounter order survives within every group.
print (groupBy (x -> x % 3) [1..9])
print (mergeWith (+) (HashMap [apples: 3]) (HashMap [apples: 4, pears: 2]))

# Absence and failure are values you can transform.
print ([1..] $ find (>100) $ mapOption sq)  # Some 10201
print (Err "invalid input" $ mapError upper)
print (reverse "APN 😀")

# Typed values still use checked arithmetic.
print ([1..4] * Int32 $ sum)
