std <- import "std"
[..] = std.option
# Open with: ./editors/neovim/try-apn examples/editor-playground.apn
# Try K over double, or Ctrl-X Ctrl-O after typing part of a name.
# Delete the 2 below: a diagnostic appears. Restore it: the error clears.

double x = x * 2

handlers = [
    Some y -> y
    None -> 0
]
print (Some 42 ~ handlers)                # 42

print (double 21)                         # 42

# Terminal colors: yellow digits; peach operators and numeric markers.
print [0xFF,0b101,0o77,2i,1/3,2@0,-1,1e3]
print (True ? "yes" : "no")
