# Run ./examples/c-interop/run-donut [frame-count]. Ctrl+C ends the animation.
std <- import "std"
use std.[function,sequence,text,io]
ffi <- import "std/ffi"
args <- getArgs
path = head args
frames = null (tail args) ? [0..] : take (parseInt (head (tail args))) [0..]
ffi.withLibrary path [
    donut_start = ffi.function [Int32,Int32] Bool
    donut_frame = ffi.function [Float,Float] Bool
    donut_finish = ffi.function [] []
] c -> c.donut_start 80 40 ? {
    renderFrame n = c.donut_frame (inexact n * .04) (inexact n * .02)
    # length drives the lazy frames; C returns False after Ctrl+C.
    seq (length (takeWhile id (map renderFrame frames))) c.donut_finish
} : fail "could not initialize terminal donut"
