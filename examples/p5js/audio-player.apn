# Audio Player, from https://p5js.org/examples/imported-media-create-audio/
# Create a player for an audio file.
std <- import "std"
use std.p5

player = createAudio "assets/piano-loop.mp3"

setup (p : Sketch) = {
    p.noCanvas
    player.attribute "aria-description" ("The playback speed of this audio player is "
        ++ "controlled by the position of the mouse. The further to the right the mouse is, "
        ++ "the faster the audio will play.")
    # The browser's controls for the audio.
    player.showControls
}

# Faster further right.
draw (p : Sketch) = player.speed (1 + p.mouseX / p.windowWidth)

main = sketch [setup = setup, draw = draw]
