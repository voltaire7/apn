# Triangle Strip, from https://p5js.org/examples/angles-and-motion-triangle-strip/
# Split a ring into triangles.
std <- import "std"
[..] = std.html
[..] = std.number
[..] = std.p5
[browser] = std

Msg = | Counted Int

[insideRadius,outsideRadius] = [100,150]

init = [0,browser.none]

update (Counted count) _ = [count,browser.none]

# The canvas, and a label showing how many points the ring has.
view count = div [style "position" "relative"] [
    canvas [setup = setup, draw = draw count]
    div [
        style "position" "absolute"
        style "left" "20px"
        style "top" "10px"
        style "color" "white"
    ] [text ("pointCount: " ++ to String count)]
]

setup (p : Sketch) = {
    p.call "createCanvas" [720,400,p.WEBGL]
    p.angleMode p.DEGREES
    p.colorMode p.HSB
    p.describe ("Rainbow ring made up of triangles whose vertices lie on two concentric "
        ++ "circles.")
}

# A strip of triangles between two circles, more of them further right.
draw shown (p : Sketch) = {
    p.background 0
    [centerX, centerY] = [p.width / 2, p.height / 2]
    p.translate -centerX -centerY
    # The sketch's values are Dynamic: Number converts one for round.
    count = round (remap p.mouseX 0 p.width 6 60 : Number) : Int
    when (count != shown) (p.send (Counted count))
    step = 180 / count
    p.call "beginShape" [p.TRIANGLE_STRIP]
    mapM (i -> {
        corner p (2 * i * step) outsideRadius centerX centerY
        corner p ((2 * i + 1) * step) insideRadius centerX centerY
    }) [0..count]
    p.endShape
}

# A vertex on the circle of this radius, at this angle, colored by it.
corner (p : Sketch) angle radius centerX centerY = {
    p.fill [angle,255,255]
    p.vertex (centerX + cos (degrees angle) * radius) (centerY + sin (degrees angle) * radius)
}

main = browser.element [
    init = init, update = update, subscriptions = _ -> browser.none, view = view
]
