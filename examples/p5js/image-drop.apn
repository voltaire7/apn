# Image Drop, from https://p5js.org/examples/input-elements-image-drop/
# Display an image that the page visitor dragged and dropped.
import ["html","text","p5"]
browser = import "browser"
file = import "file"

# The canvas shows a message, or the image dropped on it (by its URL).
Shown = Message String | Dropped String
Msg = Drop file.File | Hover

init = [Message "Drag an image file onto the canvas.", browser.none]

update msg shown = msg ~ [
    Drop f -> [
        startsWith "image/" f.mime ? Dropped f.url : Message "Not an image file!"
        browser.none
    ]
    Hover -> [shown,browser.none]
]

# The canvas's box takes the drop (and the page does not open the file).
view shown = div [
    style "display" "inline-block"
    preventDefaultOn "dragover" (_ -> Hover)
    preventDefaultOn "drop" (event -> null event.files ? Hover : Drop (head event.files))
] [canvas [setup: setup, draw: draw shown]]

setup (p : Sketch) = p.createCanvas 710 400

draw shown (p : Sketch) = shown ~ [
    Dropped url -> p.call "image" [url,0,0,p.width,p.height]
    Message message -> {
        p.background 100
        p.fill 255
        p.noStroke
        p.textSize 24
        p.textAlign p.CENTER
        p.text message (p.width / 2) (p.height / 2)
        p.describe ("Grey canvas with the text \"" ++ message ++ "\" in the center.")
    }
]

main = browser.element [init: init, update: update, subscriptions: _ -> browser.none, view: view]
