# Custom Geometry, from https://p5js.org/examples/3d-custom-geometry/
# Combine 3D shapes into a model, and draw it again and again.
std <- import "std"
[..] = std.p5

drawSnake (p : Sketch) = {
    p.call "colorMode" [p.HSB,100]
    hue <- p.random 0 100
    p.fill [hue,50,100]
    # The head.
    p.push
    p.call "scale" [1,0.5,1.4]
    p.sphere 50
    p.pop
    # The eyes, one each side.
    mapM (side -> {
        p.push
        p.call "scale" [side,1,1]
        p.fill "black"
        p.call "translate" [20,-20,10]
        p.sphere 10
        p.pop
    }) [-1,1]
    p.call "translate" [0,0,50]
    # The body, a segment at a time, each turned a little.
    length <- p.random 10 30
    segments = ceiling (length : Number) : Int
    mapM (segment -> {
        turn <- p.random -60 60
        p.rotateY turn
        p.call "translate" [0,0,50]
        p.push
        p.rotateX 90
        p.call "scale" [1,1,0.5]
        p.cylinder (constrain (remap segment (segments - 5) segments 50 0) 0 50) 100
        p.pop
        p.call "translate" [0,0,50]
    }) [0..segments - 1]
}

# The snake model: each click makes a new one.
snake = Mutable (buildGeometry drawSnake)

# A snake, centered and scaled to a common size.
newSnake = {
    set snake (buildGeometry drawSnake)
    snake.normalize
}

setup (p : Sketch) = {
    p.call "createCanvas" [700,400,p.WEBGL]
    p.angleMode p.DEGREES
    p.describe "A tiled plane of snake models"
    newSnake
}

draw (p : Sketch) = {
    p.background 255
    p.noStroke
    p.scale 1.5
    # Slowly around the plane of snakes.
    p.rotateX -45
    p.rotateY (p.frameCount * 0.25)
    p.lights
    p.specularMaterial "white"
    p.shininess 100
    # The snake, tiled along the ground.
    mapM (x -> mapM (z -> {
        p.push
        p.call "translate" [x * 200, 0, z * 200]
        p.model snake
        p.pop
    }) [-4..4]) [-4..4]
}

mousePressed _ = newSnake

main = sketch [setup = setup, draw = draw, mousePressed = mousePressed]
