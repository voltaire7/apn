# Soft Body, from https://p5js.org/examples/math-and-physics-soft-body/
# Make a shape that springs toward the mouse and wobbles as it moves.
std <- import "std"
[..] = std.number
[..] = std.sequence
[..] = std.p5

# Around the center, five nodes, each wobbling at its own frequency (degrees a
# frame) as the body accelerates; organic is how loosely the curve bends.
Body = [
    center : [Float,Float], acceleration : [Float,Float], nodes : List [Float,Float]
    angles : List Float, frequencies : List Float, organic : Float
]
body = Mutable ([
    center = [0.0,0.0], acceleration = [0.0,0.0], nodes = [], angles = [], frequencies = []
    organic = 1.0
] : Body)
radius = 45
springing = 0.0009
damping = 0.98
nodeCount = 5

setup (p : Sketch) = {
    p.createCanvas 710 400
    frequencies <- mapM (_ -> p.random 5 12) [1..nodeCount]
    set body ([
        center = [(p.width / 2 : Float), (p.height / 2 : Float)], acceleration = [0.0,0.0]
        nodes = replicate nodeCount [0.0,0.0], angles = replicate nodeCount 0.0
        frequencies = map Float frequencies, organic = 1.0
    ] : Body)
    p.noStroke
}

draw (p : Sketch) = {
    p.background [0,50]
    drawShape p
    set body (move [(p.mouseX : Float), (p.mouseY : Float)] body)
}

# A closed curve through the nodes, red when still and yellow when moving fast.
drawShape (p : Sketch) = {
    p.splineProperty "tightness" body.organic
    red <- p.color "red"
    yellow <- p.color "yellow"
    color <- p.lerpColor red yellow body.organic
    p.fill color
    p.beginShape
    mapM ([x,y] -> p.splineVertex x y) body.nodes
    p.call "endShape" [p.CLOSE]
}

# The body springs toward the mouse; its nodes wobble around their places
# about the center, the more the faster it goes.
move mouse (Body body) = {
    acceleration = body.acceleration + (mouse - body.center) * springing
    damped = acceleration * damping
    [ax,ay] = damped
    angle n = degrees (-90 + 360 * n / nodeCount)
    resting n = body.center + [cos (angle n), sin (angle n)] * radius
    wobble n turn = resting n + [sin (degrees turn), sin (degrees turn)] * damped * 2
    body.center = body.center + acceleration
    body.acceleration = damped
    body.organic = 1 - (abs ax + abs ay) * 0.1
    body.nodes = map ([n,turn] -> wobble n turn) (zip [0..nodeCount - 1] body.angles)
    body.angles = body.angles + body.frequencies
    body
}

main = sketch [setup = setup, draw = draw]
