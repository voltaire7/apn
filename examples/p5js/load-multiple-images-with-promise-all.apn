# Load Multiple Images with Promise.all, from
# https://p5js.org/examples/loading-and-saving-data-load-multiple-images/
# Load several images at once, and draw them once they all have loaded.
import "p5"

# Three random photos from picsum.photos.
image1 = loadImage "https://picsum.photos/100/100?random=1"
image2 = loadImage "https://picsum.photos/100/100?random=2"
image3 = loadImage "https://picsum.photos/100/100?random=3"

# Setup waits for preload's images, as for Promise.all's.
setup (Sketch p) = {
    p.textOutput
    p.createCanvas 600 400
    p.background 220
    p.call "textAlign" [p.CENTER,p.CENTER]
    p.textSize 18
    p.image image1 100 150
    p.image image2 250 150
    p.image image3 400 150
    p.fill 0
    p.text "All images loaded!" (p.width / 2) 50
}

main = sketch [preload: [image1,image2,image3], setup: setup]
