# Non-Orthogonal Reflection, from
# https://p5js.org/examples/math-and-physics-non-orthogonal-reflection/
# Bounce a ball off a slanted surface.
std <- import "std"
use std.[array,number,p5]

# The ball's size and speed.
radius = 6
speed = 3.5
# The slanted base's two top corners, the ball's place and velocity, and colors.
baseLeft = Mutable [0.0,0.0]
baseRight = Mutable [0.0,0.0]
position = Mutable [0.0,0.0]
velocity = Mutable [0.0,0.0]
baseColor = Mutable [0.0,70.0,70.0]
circleColor = Mutable [0.0,90.0,90.0]

setup (p : Sketch) = {
    p.createCanvas 710 400
    p.call "colorMode" [p.HSB,360,100,100]
    set baseLeft [0.0, (p.height - 150 : Float)]
    set baseRight [(p.width : Float), (p.height : Float)]
    setColors p
    set position [(p.width / 2 : Float), (p.height / 2 : Float)]
    # A random direction.
    angle <- p.random 0 (2 * pi)
    set velocity (fromAngle (angle : Float) * speed)
    p.describe "A simulation of a ball bouncing on slanted surfaces."
}

setColors (p : Sketch) = {
    baseHue <- p.random 30 180
    circleHue <- p.random 30 180
    set baseColor [(baseHue : Float), 70.0, 70.0]
    set circleColor [(circleHue : Float), 90.0, 90.0]
}

draw (p : Sketch) = {
    p.background [30,50]
    p.frameRate 30
    # The base.
    p.fill baseColor
    p.noStroke
    [leftX,leftY] = baseLeft
    [rightX,rightY] = baseRight
    p.quad leftX leftY rightX rightY p.width p.height 0 p.height
    # The ball.
    p.fill circleColor
    [x,y] = position
    p.circle x y (2 * radius)
    set position (position + velocity)
    handleBaseCollision p
    handleBoundaryCollision p
}

# Below the base's top, the ball turns back about the base's normal (and a
# line shows the normal).
handleBaseCollision (p : Sketch) = {
    [dx,dy] = normalize (baseRight - baseLeft)
    normal = [dy,-dx]
    when (dot position normal < dot baseLeft normal) {
        set velocity (velocity - normal * (2 * dot velocity normal : Float))
        p.stroke 255
        p.strokeWeight 5
        [x,y] = position
        [normalX,normalY] = normal * 100
        p.line x y (x + normalX) (y + normalY)
    }
}

# Off a side, the ball turns back; off the top too, and the base and colors change.
handleBoundaryCollision (p : Sketch) = {
    [x,y] = position
    when (x < radius || x > p.width - radius) (set velocity (velocity * [-1.0,1.0]))
    when (y < radius) {
        set velocity (velocity * [1.0,-1.0])
        left <- p.random (p.height - 100) p.height
        right <- p.random (p.height - 100) p.height
        set baseLeft [0.0, (left : Float)]
        set baseRight [(p.width : Float), (right : Float)]
        setColors p
    }
}

main = sketch [setup = setup, draw = draw]
