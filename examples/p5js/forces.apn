# Forces, from https://p5js.org/examples/math-and-physics-forces/
# Simulate gravity, and the drag of a liquid, on falling balls.
std <- import "std"
[..] = std.p5

# A ball: its mass, where it is, its velocity and its hue.
Mover = [mass : Float, position : [Float,Float], velocity : [Float,Float], hue : Int]
movers = Mutable ([] : List Mover)
# The liquid fills the canvas's lower half, and drags by this coefficient.
drag = 0.1

setup (p : Sketch) = {
    p.createCanvas 720 400
    p.call "colorMode" [p.HSB,9,100,100]
    initializeMovers p
    p.describe ("Nine grey balls drop from the top of the canvas and slow down as they reach "
        ++ "the bottom half of the canvas.")
}

# Nine balls of random masses, spaced along the top.
initializeMovers (p : Sketch) = {
    spacing = p.width / 9
    made <- mapM (n -> {
        mass <- p.random 0.5 3
        return [
            mass = (mass : Float), position = [(spacing * n + spacing / 2 : Float), 0.0]
            velocity = [0.0,0.0], hue = n
        ]
    }) [0..8]
    set movers made
}

draw (p : Sketch) = {
    p.background 20
    p.noStroke
    p.fill 50
    p.rect 0 (p.height / 2) p.width (p.height / 2)
    moved = map (fall p.height) movers
    mapM (display p) moved
    set movers (map (bounce (p.height : Float)) moved)
}

# Gravity, and in the liquid its drag (against the velocity, growing with
# speed squared), move a ball.
fall height mover = {
    [_,y] = mover.position
    speed = mag mover.velocity
    resistance = y > height / 2 ? setMag (drag * speed * speed) -mover.velocity : [0.0,0.0]
    mover.velocity = mover.velocity + resistance / mover.mass + [0.0,0.1]
    mover.position = mover.position + mover.velocity
    mover
}

# A ball at the bottom bounces back up, losing some speed.
bounce height mover = {
    [x,y] = mover.position
    [vx,vy] = mover.velocity
    floor = height - mover.mass * 8
    y > floor ? { mover.velocity = [vx, vy * -0.9]; mover.position = [x,floor]; mover } : mover
}

display (p : Sketch) mover = {
    [x,y] = mover.position
    p.stroke 0
    p.strokeWeight 2
    p.fill [mover.hue,100,100]
    p.ellipse x y (mover.mass * 16) (mover.mass * 16)
}

mousePressed (p : Sketch) = initializeMovers p

main = sketch [setup = setup, draw = draw, mousePressed = mousePressed]
