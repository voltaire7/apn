# Circle Clicker, from https://p5js.org/examples/games-circle-clicker/
# Make a game about clicking a circle quickly and save the high score.
import "p5"

# The circle (a radius of 0 shows the start screen), its largest radius now,
# the score and the high score.
center = Mutable [0.0,0.0]
radius = Mutable 0.0
color = Mutable [0.0,0.0,0.0]
largest = Mutable 0.0
score = Mutable 0
highScore = Mutable 0

setup (p : Sketch) = {
    p.createCanvas 720 400
    p.colorMode p.HSB
    p.noStroke
    p.ellipseMode p.RADIUS
    p.textSize 36
    # The high score kept from an earlier visit (where the page may keep one).
    stored <- p.getItem "high score"
    set highScore (stored == [] ? 0 : (stored : Int))
}

draw (p : Sketch) = {
    p.background 20
    radius > 0 ? {
        # The circle, shrinking, and the score.
        [x,y] = center
        p.fill color
        p.circle x y radius
        p.describeElement "Circle" "Randomly colored shrinking circle"
        set radius (radius - 1)
        p.call "textAlign" [p.RIGHT,p.TOP]
        p.fill 220
        p.text (to String score) (p.width - 20) 20
        p.describeElement "Score" ("Text with current score: " ++ to String score)
    } : endGame p
}

startGame (p : Sketch) = {
    set score 0
    set largest (min (p.height : Number) (p.width : Number) / 2 : Float)
    resetCircle p
}

endGame (p : Sketch) = {
    p.noLoop
    set highScore (max highScore score)
    p.storeItem "high score" highScore
    p.call "textAlign" [p.CENTER,p.CENTER]
    p.fill 220
    startText = "Circle Clicker\nClick the circle before it gets too small\nScore: "
        ++ to String score ++ "\nHigh score: " ++ to String highScore ++ "\nClick to play"
    p.call "text" [startText,0,0,p.width,p.height]
    p.describeElement "Start text" ("Text reading, \"" ++ startText ++ "\"")
}

# A new circle, as large as it may be now, somewhere it fits, in a random color.
resetCircle (p : Sketch) = {
    set radius largest
    x <- p.random radius (p.width - radius)
    y <- p.random radius (p.height - radius)
    h <- p.random 240 360
    s <- p.random 40 80
    b <- p.random 50 90
    set center [(x : Float), (y : Float)]
    set color [(h : Float), (s : Float), (b : Float)]
}

# A click on the circle scores, and the next circle starts smaller; a click
# on the start screen starts a game.
mousePressed (p : Sketch) = {
    (looping : Bool) <- p.isLooping
    looping ? {
        [x,y] = center
        when (dist p.mouseX p.mouseY x y < radius) {
            set largest (max (largest - 1) 15.0)
            resetCircle p
            set score (score + 1)
        }
    } : {
        startGame p
        p.loop
    }
}

main = sketch [setup = setup, draw = draw, mousePressed = mousePressed]
