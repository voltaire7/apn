# Drawing Lines, from https://p5js.org/examples/animation-and-variables-drawing-lines/
# Draw with the mouse.
std <- import "std"
use std.p5

setup (p : Sketch) = {
    p.createCanvas 710 400
    p.background 0
    p.strokeWeight 10
    p.colorMode p.HSB
    p.describe "A blank canvas where the user draws by dragging the mouse"
}

# A line from the mouse's previous position to its current one, its hue from
# where it is.
mouseDragged (p : Sketch) = {
    p.stroke [p.mouseX - p.mouseY, 90, 90]
    p.line p.pmouseX p.pmouseY p.mouseX p.mouseY
}

main = sketch [setup = setup, mouseDragged = mouseDragged]
