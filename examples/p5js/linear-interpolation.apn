# Linear Interpolation, from https://p5js.org/examples/calculating-values-interpolate/
# Convert a number between 0 and 1 to another range.
import "p5"

# The circle's position: each frame it goes 5% of the way to the mouse.
x = Mutable 0.0
y = Mutable 0.0

setup (Sketch p) = {
    p.createCanvas 720 400
    p.noStroke
    p.textOutput
}

draw (Sketch p) = {
    p.background 51
    set x (Float (lerp x p.mouseX 0.05))
    set y (Float (lerp y p.mouseY 0.05))
    p.fill 255
    p.stroke 255
    p.ellipse x y 66 66
}

main = sketch [setup: setup, draw: draw]
