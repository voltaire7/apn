# Constrain, from https://p5js.org/examples/calculating-values-constrain/
# Keep a number within a range.
import "p5"

radius = 24
edge = 100
inner = edge + radius

setup (p : Sketch) = {
    p.createCanvas 720 400
    p.noStroke
    p.ellipseMode p.RADIUS
    p.rectMode p.CORNERS
    p.describe ("Pink rectangle on a grey background. The cursor moves a white circle within "
        ++ "the pink rectangle.")
}

draw (p : Sketch) = {
    p.background 230
    p.fill [237,34,93]
    p.rect edge edge (p.width - edge) (p.height - edge)
    # The circle follows the mouse, but stays inside the rectangle.
    p.fill 255
    x = constrain p.mouseX inner (p.width - inner)
    y = constrain p.mouseY inner (p.height - inner)
    p.circle x y radius
}

main = sketch [setup = setup, draw = draw]
