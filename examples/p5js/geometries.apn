# Geometries, from https://p5js.org/examples/3d-geometries/
# Draw 3D shapes, including a custom model.
import "p5"

# A NASA model of an astronaut.
astronaut = loadModel "assets/astronaut.obj"

setup (p : Sketch) = {
    p.call "createCanvas" [710,400,p.WEBGL]
    p.angleMode p.DEGREES
    # Colors that show which way each face of a shape points.
    p.normalMaterial
    p.describe ("Eight 3D shapes: a plane, box, cylinder, cone, torus, sphere, ellipsoid, and a "
        ++ "model of an astronaut. Each shape is rotating in all directions. The surface of the "
        ++ "shapes are multicolored.")
}

# Each shape where it stands, as it draws itself.
shapes = [
    [-250, -100, (p : Sketch) -> p.plane 70 70]
    [-75, -100, (p : Sketch) -> p.box 70 70 70]
    [100, -100, (p : Sketch) -> p.cylinder 70 70]
    [275, -100, (p : Sketch) -> p.cone 50 70]
    [-250, 100, (p : Sketch) -> p.torus 50 20]
    # A black stroke shows the sphere's movement.
    [-75, 100, (p : Sketch) -> { p.stroke 0; p.sphere 50 }]
    [100, 100, (p : Sketch) -> p.ellipsoid 20 40 40]
    # Turned to start upright.
    [275, 100, (p : Sketch) -> { p.rotateZ 180; p.model astronaut }]
]

draw (p : Sketch) = {
    p.background 250
    mapM ([x,y,shape] -> {
        p.push
        p.translate x y
        rotateWithFrameCount p
        shape p
        p.pop
    }) shapes
}

# A degree a frame around each axis.
rotateWithFrameCount (p : Sketch) = {
    p.rotateZ p.frameCount
    p.rotateX p.frameCount
    p.rotateY p.frameCount
}

main = sketch [preload = [astronaut], setup = setup, draw = draw]
