# Random Poetry, from https://p5js.org/examples/listing-data-with-arrays-random-poetry/
# Generate a poem with words randomly selected from a bank.
import "p5"

words = [
    "p5.js", "is", "a", "JavaScript", "library", "for", "creative", "coding", "with", "a"
    "focus", "on", "making", "coding", "accessible", "and", "inclusive", "for", "artists"
    "designers", "educators", "beginners", "and", "anyone", "else!", "p5.js", "is", "free"
    "and", "open-source", "because", "we", "believe", "software", "and", "the", "tools", "to"
    "learn", "it", "should", "be", "accessible", "to", "everyone", "Using", "the", "metaphor"
    "of", "a", "sketch", "p5.js", "has", "a", "full", "set", "of", "drawing", "functionality"
    "However", "you're", "not", "limited", "to", "your", "drawing", "canvas", "You", "can"
    "think", "of", "your", "whole", "browser", "page", "as", "your", "sketch", "including"
    "HTML5", "objects", "for", "text", "input", "video", "webcam", "and", "sound"
]

setup (Sketch p) = {
    p.describe "A random series of words related to p5.js scattered onto the canvas."
    p.textFont "Space Mono"
    p.createCanvas 720 400
    p.textAlign p.CENTER
    p.colorMode p.HSB
    hue <- p.random 180 360
    p.background [hue, 95, 25]
    # Twenty words from the bank, each a random size, brightness and place.
    mapM (_ -> {
        size <- p.random 16 48
        brightness <- p.random 50 95
        word <- p.call "random" [words]
        x <- p.random 0 p.width
        y <- p.random 0 p.height
        p.textSize size
        p.fill [hue, 200, brightness]
        p.text word x y
    }) [1..20]
}

main = sketch [setup: setup]
