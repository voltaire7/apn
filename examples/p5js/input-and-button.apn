# Input and Button, from https://p5js.org/examples/input-elements-input-button/
# Use text input from the page visitor.
import ["html","p5"]
browser = import "browser"

# The name being typed, and the one submitted last.
Model = [typing: String, name: String]
Msg = Typed String | Greet

init = [[typing: "", name: ""], browser.none]

update msg model = match msg [
    Typed typing -> { model.typing = typing; [model,browser.none] }
    Greet -> [[typing: "", name: model.typing], browser.none]
]

# A heading, a field and a button over the canvas, which shows the name.
view model = div [style "position" "relative"] [
    canvas [setup: setup, draw: draw model.name]
    h2 (at 20 5) [text (model.name == "" ? "What is your name?" : "Hello, " ++ model.name ++ "!")]
    form (onSubmit Greet :: at 20 65) [
        input [value model.typing, onInput Typed] []
        button [] [text "submit"]
    ]
]

# Attributes placing an element at x, y over the canvas.
at x y = [
    style "position" "absolute"
    style "left" (to String x ++ "px")
    style "top" (to String y ++ "px")
    style "margin" "0"
]

setup (Sketch p) = p.createCanvas 710 400

draw name (Sketch p) = {
    p.background 255
    p.textSize 100
    p.call "textAlign" [p.CENTER,p.CENTER]
    p.text name (p.width / 2) (p.height / 2)
    p.describe ("The name " ++ name ++ " in large black text on a white background.")
}

main = browser.element [init: init, update: update, subscriptions: _ -> browser.none, view: view]
