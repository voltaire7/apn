import "meta"

# These strings go through an APN lexer, parser, environment, and evaluator.
print (metaEval "1 + 2 * 3")                             # 7
print (metaEval "1 / 3 + 1 / 6")                         # 1/2
print (metaEval "constant x y = x; constant 42 missing")  # 42
print (metaEval "fact n = n == 0 ? 1 : n * fact (n - 1); fact 5")  # 120
print (metaEval "x = 1:x; take 6 x")                     # [1, 1, 1, 1, 1, 1]
print (metaEval "outer x = { inner y = x + y; inner }; outer 40 2") # 42

# The parser's output is ordinary data, usable without evaluating the program.
print (metaParse "x -> x + 1")
