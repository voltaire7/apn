# Drag-and-Drop, from https://elm-lang.org/examples/drag-and-drop
# Image upload with a drag and drop zone.
import "html"
browser = import "browser"
file = import "file"

Msg = Pick | DragEnter | DragLeave | GotFiles Dynamic Dynamic

init = [[hover: false, files: []],browser.none]

update msg model = match msg [
    Pick -> [model,file.selectFiles ["image/*"] GotFiles]
    DragEnter -> { model.hover = true; [model,browser.none] }
    DragLeave -> { model.hover = false; [model,browser.none] }
    GotFiles first others -> {
        model.[files,hover] = [first :: others,false]
        [model,browser.none]
    }
]

subscriptions _ = browser.none

view model = div [
    style "border" (model.hover ? "6px dashed purple" : "6px dashed #ccc")
    style "border-radius" "20px"
    style "width" "480px"
    style "height" "100px"
    style "margin" "100px auto"
    style "padding" "20px"
    style "display" "flex"
    style "flex-direction" "column"
    style "justify-content" "center"
    style "align-items" "center"
    preventDefaultOn "dragenter" (_ -> DragEnter)
    preventDefaultOn "dragover" (_ -> DragEnter)
    preventDefaultOn "dragleave" (_ -> DragLeave)
    preventDefaultOn "drop" dropped
] [
    button [onClick Pick] [text "Upload Images"]
    span [style "color" "#ccc"] [text (to String model)]
]

# A drop of one file or more (Elm's oneOrMore): no files is a drag leaving.
dropped event = null event.files ? DragLeave : GotFiles (head event.files) (tail event.files)

main = browser.element [init: init, update: update, subscriptions: subscriptions, view: view]
