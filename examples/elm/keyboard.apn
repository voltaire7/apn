# Keyboard, from https://elm-lang.org/examples/keyboard
# Move a square around with the arrow keys: UP, DOWN, LEFT, RIGHT
# Try making it move around more quickly!
std <- import "std"
[..] = std.playground

view _ [x,y] = [move x y $ square blue 40]

update computer [x,y] = [x + toX computer.keyboard, y + toY computer.keyboard]

main = game view update [0,0]
