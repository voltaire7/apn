# Crate, from https://elm-lang.org/examples/crate
# Demonstrate how to load textures and put them on a cube. Elm loads
# https://elm-lang.org/images/wood-crate.jpg, an image WebGL cannot use from
# another site, so this crate's wood is drawn once into a p5 graphic.
import "html"
browser = import "browser"
p5 = import "p5"

Msg = | TimeDelta Number

init = [0,browser.none]

update (TimeDelta dt) angle = [angle + dt / 5000,browser.none]

subscriptions _ = browser.onAnimationFrameDelta TimeDelta

view angle = p5.canvas [setup: setup, draw: draw angle]

setup p = p.call "createCanvas" [400,400,p.WEBGL]

draw angle p = {
    p.background "white"
    p.perspective (p.PI / 4) 1 0.01 100
    p.camera 0 0 5 0 0 0 0 (-1) 0
    p.rotateY (3 * angle)
    p.rotateX (2 * angle)
    p.noStroke []
    crate <- p.graphic "crate" 256 256 wood
    p.texture crate
    p.box 2 2 2
}

# Planks inside a frame, with a diagonal brace.
wood g = {
    g.background [176,122,62]
    g.stroke [120,78,36]
    g.strokeWeight 3
    mapM (y -> g.line 0 y 256 y) [64,128,192]
    g.noStroke []
    g.fill [140,92,44]
    g.rect 0 0 256 28
    g.rect 0 228 256 28
    g.rect 0 0 28 256
    g.rect 228 0 28 256
    g.stroke [140,92,44]
    g.strokeWeight 30
    g.line 28 228 228 28
    g.noFill []
    g.stroke [90,58,26]
    g.strokeWeight 4
    g.rect 2 2 252 252
}

main = browser.element [init: init, update: update, subscriptions: subscriptions, view: view]
