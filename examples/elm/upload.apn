# Upload, from https://elm-lang.org/examples/upload
# File upload with the <input type="file"> node.
import "html"
browser = import "browser"
file = import "file"

Msg = | GotFiles (List file.File)

init = [[],browser.none]

update (GotFiles files) _ = [files,browser.none]

subscriptions _ = browser.none

view model = div [] [
    input [typeAttribute "file",multiple true,onEvent "change" (event -> GotFiles event.files)] []
    div [] [text (to String model)]
]

main = browser.element [init: init, update: update, subscriptions: subscriptions, view: view]
