# Triangle, from https://elm-lang.org/examples/triangle
# A spinning triangle, its corners red, green and blue. Elm draws it with
# WebGL shaders; here a p5 WEBGL canvas in the view draws it each frame,
# with the camera the model's time puts it at.
std <- import "std"
use std.html
[browser,p5] = std

Msg = | TimeDelta Number

init = [0,browser.none]

update (TimeDelta delta) currentTime = [delta + currentTime, browser.none]

subscriptions _ = browser.onAnimationFrameDelta TimeDelta

view t = p5.canvas [setup = setup, draw = draw (t / 1000)]

setup p = p.call "createCanvas" [400,400,p.WEBGL]

# The camera circles the origin, 4 away, looking at it; y is up.
draw t p = {
    p.background "white"
    p.perspective (p.PI / 4) 1 0.01 100
    p.camera (4 * cos t) 0 (4 * sin t) 0 0 0 0 -1 0
    p.noStroke
    p.call "beginShape" [p.TRIANGLES]
    vertex p [255,0,0] [0,0,0]
    vertex p [0,255,0] [1,1,0]
    vertex p [0,0,255] [1,-1,0]
    p.endShape
}

vertex p color [x,y,z] = {
    p.fill color
    p.call "vertex" [x,y,z]
}

main = browser.element [init = init, update = update, subscriptions = subscriptions, view = view]
