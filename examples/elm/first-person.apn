# First Person, from https://elm-lang.org/examples/first-person
# Walk around in 3D space using the keyboard. Elm textures its crate with
# https://elm-lang.org/images/wood-crate.jpg, an image WebGL cannot use from
# another site, so this crate's wood is drawn into a p5 graphic (as in Crate).
import "html"
browser = import "browser"
p5 = import "p5"

eyeLevel = 2
noKeys = [up: False, left: False, down: False, right: False, space: False]

Msg =
    | KeyChanged Bool String
    | TimeDelta Number
    | Resized Number Number
    | GotViewport browser.Viewport
    | VisibilityChanged browser.Visibility

init = [[
    keys: noKeys
    width: 400
    height: 400
    person: [position: [0.0, inexact eyeLevel, -10.0], velocity: [0.0,0.0,0.0]]
], browser.getViewport GotViewport]

update msg model = match msg [
    KeyChanged isDown key -> {
        model.keys = updateKeys isDown key model.keys
        [model,browser.none]
    }
    TimeDelta dt -> {
        model.person = updatePerson dt model.keys model.person
        [model,browser.none]
    }
    Resized width height -> { model.[width,height] = [width,height]; [model,browser.none] }
    GotViewport viewport -> {
        model.[width,height] = [viewport.width,viewport.height]
        [model,browser.none]
    }
    VisibilityChanged _ -> { model.keys = noKeys; [model,browser.none] }
]

updateKeys isDown key keys = match key [
    " " -> keys [space: isDown]
    "ArrowUp" -> keys [up: isDown]
    "ArrowLeft" -> keys [left: isDown]
    "ArrowDown" -> keys [down: isDown]
    "ArrowRight" -> keys [right: isDown]
    _ -> keys
]

updatePerson dt keys person = {
    velocity = stepVelocity dt keys person
    [vx,_,vz] = velocity
    [x,y,z] = person.position + velocity * (dt / 500)
    y < eyeLevel
        ? [position: [x, inexact eyeLevel, z], velocity: [vx,0.0,vz]]
        : [position: [x,y,z], velocity: velocity]
}

stepVelocity dt keys person = {
    [vx,vy,vz] = person.velocity
    [_,y,_] = person.position
    toV positive negative = (positive ? 1.0 : 0.0) - (negative ? 1.0 : 0.0)
    y > eyeLevel
        ? [vx, vy - dt / 250, vz]
        : [toV keys.left keys.right, keys.space ? 2.0 : 0.0, toV keys.up keys.down]
}

subscriptions _ = browser.batch [
    browser.onResize Resized
    browser.onKeyUp (KeyChanged False)
    browser.onKeyDown (KeyChanged True)
    browser.onAnimationFrameDelta TimeDelta
    browser.onVisibilityChange VisibilityChanged
]

# The wood, drawn once into a graphic when the canvas starts.
crate = p5.createGraphics 256 256

view model = div [
    style "position" "absolute"
    style "left" "0"
    style "top" "0"
    style "width" (to String model.width ++ "px")
    style "height" (to String model.height ++ "px")
] [
    p5.canvas [setup: setup, draw: draw model]
    keyboardInstructions model.keys
]

setup p = {
    p.call "createCanvas" [400,400,p.WEBGL]
    wood crate
}

# The eye looks along z from the person's position (p5's y grows downward).
draw model p = {
    when (p.width != model.width || p.height != model.height)
        (p.resizeCanvas model.width model.height)
    [x,y,z] = model.person.position
    p.background "white"
    p.perspective (p.PI / 4) (model.width / model.height) 0.01 100
    p.camera x (0 - y) z x (0 - y) (z + 1) 0 1 0
    p.noStroke
    p.texture crate
    p.box 2 2 2
}

keyboardInstructions _ = div [
    style "position" "absolute"
    style "font-family" "monospace"
    style "text-align" "center"
    style "left" "20px"
    style "right" "20px"
    style "top" "20px"
] [
    p [] [text "Walk around with a first person perspective."]
    p [] [text "Arrows keys to move, space bar to jump."]
]

# Planks inside a frame, with a diagonal brace.
wood g = {
    g.background [176,122,62]
    g.stroke [120,78,36]
    g.strokeWeight 3
    mapM (y -> g.line 0 y 256 y) [64,128,192]
    g.noStroke
    g.fill [140,92,44]
    g.rect 0 0 256 28
    g.rect 0 228 256 28
    g.rect 0 0 28 256
    g.rect 228 0 28 256
    g.stroke [140,92,44]
    g.strokeWeight 30
    g.line 28 228 228 28
    g.noFill
    g.stroke [90,58,26]
    g.strokeWeight 4
    g.rect 2 2 252 252
}

main = browser.element [init: init, update: update, subscriptions: subscriptions, view: view]
