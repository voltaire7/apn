# Examples, from https://elm-lang.org/examples
# The page listing these examples. apn --site examples/elm OUTPUT builds it,
# with an editor for each example.
std <- import "std"
use std.[html,text]
[gallery] = std

main = gallery.page "Examples" [
    text "Elm's "
    a [href "https://elm-lang.org/examples"] [text "examples"]
    text ", recreated in APN. Each opens in an editor, where you can change it and run it again."
] [
    gallery.examples "HTML" [example "Hello", example "Groceries", example "Shapes"]
    gallery.examples "User Input" [example "Buttons", example "Text Fields", example "Forms"]
    gallery.examples "Random" [example "Numbers", example "Cards", example "Positions"]
    gallery.examples "HTTP" [example "Book", example "Quotes"]
    gallery.examples "Time" [gallery.link "Time" "local-time", example "Clock"]
    gallery.examples "Files" [example "Upload", example "Drag-and-Drop", example "Image Previews"]
    gallery.examples "WebGL" (map example ["Triangle","Cube","Crate","Thwomp","First Person"])
    gallery.examples "Playground"
        (map example ["Picture","Animation","Mouse","Keyboard","Turtle","Mario"])
]

# An example's file is its title in lower case, with - for spaces (Elm's
# URL), except where a file needs another name: local-time.apn would hide
# the time module from its neighbors if it were time.apn.
example title = gallery.link title (replaceAll " " "-" (lower title))
