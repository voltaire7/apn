# Mario, from https://elm-lang.org/examples/mario
# Walk around with the arrow keys. Press the UP arrow to jump!
import "playground"

view computer mario = {
    w = computer.screen.width
    h = computer.screen.height
    b = computer.screen.bottom
    [
        rectangle (rgb 174 238 238) w h
        moveY b $ rectangle (rgb 74 163 41) w 100
        move mario.x (b + 76 + mario.y) $ image 70 70 (toGif mario)
    ]
}

toGif mario = mario.y > 0 ? "https://elm-lang.org/images/mario/jump/" ++ mario.dir ++ ".gif"
    : mario.vx != 0 ? "https://elm-lang.org/images/mario/walk/" ++ mario.dir ++ ".gif"
    : "https://elm-lang.org/images/mario/stand/" ++ mario.dir ++ ".gif"

update computer mario = {
    dt = 1.666
    vx = toX computer.keyboard
    vy = mario.y == 0 ? computer.keyboard.up ? 5.0 : 0.0 : mario.vy - dt / 8
    x = mario.x + dt * vx
    y = mario.y + dt * vy
    [x: x, y: max 0 y, vx: vx, vy: vy, dir: vx == 0 ? mario.dir : vx < 0 ? "left" : "right"]
}

main = game view update [x: 0.0, y: 0.0, vx: 0, vy: 0.0, dir: "right"]
