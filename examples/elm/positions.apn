# Positions, from https://elm-lang.org/examples/positions
# A button that moves to random positions when pressed.
import "html"
browser = import "browser"
random = import "random"

Msg = Clicked | NewPosition Int Int

init = [[x = 100, y = 100], browser.none]

positionGenerator = map2 (x, y -> [x,y]) (random.int 50 350) (random.int 50 350)

update msg model = msg ~ [
    Clicked -> [model, random.generate ([x,y] -> NewPosition x y) positionGenerator]
    NewPosition x y -> [[x = x, y = y], browser.none]
]

subscriptions _ = browser.none

view model = button [
    style "position" "absolute"
    style "top" (to String model.x ++ "px")
    style "left" (to String model.y ++ "px")
    onClick Clicked
] [text "Click me!"]

main = browser.element [init = init, update = update, subscriptions = subscriptions, view = view]
