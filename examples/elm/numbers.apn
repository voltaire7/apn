# Numbers, from https://elm-lang.org/examples/numbers
# Press a button to generate a random number between 1 and 6.
std <- import "std"
[..] = std.html
[browser,random] = std

Msg = Roll | NewFace Int

init = [[dieFace = 1], browser.none]

update msg model = msg ~ [
    Roll -> [model, random.generate NewFace (random.int 1 6)]
    NewFace newFace -> [[dieFace = newFace], browser.none]
]

subscriptions _ = browser.none

view model = div [] [
    h1 [] [text (to String model.dieFace)]
    button [onClick Roll] [text "Roll"]
]

main = browser.element [init = init, update = update, subscriptions = subscriptions, view = view]
