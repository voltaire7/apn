# Packages: run with  apn examples/packages/main.apn
# import "name" finds name.apn or a name/ folder next to this file (then in
# parent folders up to the program's), else a standard module.
import "greetings"
import "shapes"
import "shapes/solid"
import "units"
import "report"

print (greet "packages")                         # Hello, packages!
print [squareArea 3, rectangleArea 2 5]          # [9, 10]
print (cubicMetres (boxVolume 2 3 4))            # 24 m³

# Imported as a value, a package is a record of its definitions.
shapes = import "shapes"
print (shapes.squareArea 4)                      # 16

print (report [["square", squareArea 3], ["rectangle", rectangleArea 2 5]])
# square: 9 m²
# rectangle: 10 m²
