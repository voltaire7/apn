import ["meta", "io"]

# The evaluator's own source, read as plain text. Pass its path as the first
# argument, or run from the repository root to use the default.
args <- getArgs
evaluatorSource <- readFile (null args ? "lib/meta/evaluator.apn" : head args)

# The APN reader parses that text. The APN evaluator runs the parsed evaluator.
# That interpreted evaluator then runs each of these programs.
print (metaSelfEval evaluatorSource "20 + 22")
print (metaSelfEval evaluatorSource "id x = x; id 42")
print (metaSelfEval evaluatorSource "true ? 42 : missing")
