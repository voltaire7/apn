load "donut"
# Optional argument: render this many frames; otherwise animate until Ctrl+C.
[args] = [getArgs ()]
frameCount = null args ? -1 : parseInt (head args)
width = 80
height = 40
dense = length args > 1 ? args 1 == "dense" : false
[samples] = [makeDonutSamples (dense ? .07 : .21) (dense ? .02 : .06)]
frames = frameCount < 0 ? [0..] : take frameCount [0..]
emit "\e[2J"
animate frame = {
    [picture] = [renderDonut samples (frame * .04) (frame * .02) width height]
    emit ("\e[H" ++ picture)
    sleep 16
}
foldl (ignored frame -> animate frame) () frames
