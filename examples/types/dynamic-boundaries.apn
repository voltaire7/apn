# Run with: apn examples/types/dynamic-boundaries.apn
# Dynamic explicitly moves these operations to runtime.
value = Dynamic 41
print (Int value + 1)                     # 42

((Int -> Int) increment) <- return (Dynamic (x -> x + 1))
print (increment 41)                     # 42

# These pass checking, but fail when evaluated:
# Int (Dynamic "hello")
# ((Int -> Int) bad) <- return (Dynamic (x -> "hello"))
# bad 1

# This fails checking: the inferred parameter has no runtime conversion.
# square x = x == 0 ? 0 : x * x
# square (Dynamic 2)
