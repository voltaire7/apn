# Check without running: apn --check examples/types/dependent-vectors.apn
# Check, then execute:   apn --checked examples/types/dependent-vectors.apn

Ints n = Vector n Int
copy n ((Ints n) values) = values
appendOne n ((Ints n) values) (Int value) = Ints (n + 1) (values ++ [value])

print (copy 3 [10, 20, 30])
print (appendOne 3 [10, 20, 30] 40)
print (typeOf (Ints 3 [10, 20, 30]))

# A type can depend on a Boolean value too.
Choice flag = flag ? Int : String
print (Choice true 123)
print (Choice false "hello")

# Uncomment to get a static length error:
# copy 3 [10, 20]
